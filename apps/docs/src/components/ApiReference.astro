---
import Table from '@caderno-ui/astro/Table.astro'
import manifest from '@caderno-ui/elements/custom-elements.json'

type ApiItem = {
  name: string
  description?: string
  type?: { text?: string }
  default?: string
  fieldName?: string
}
type Member = ApiItem & {
  attribute?: string
  kind?: string
  privacy?: string
  reflects?: boolean
}
type Declaration = {
  attributes?: ApiItem[]
  cssParts?: ApiItem[]
  cssProperties?: ApiItem[]
  description?: string
  events?: ApiItem[]
  members?: Member[]
  slots?: ApiItem[]
  tagName?: string
}
type Props = { tagName: string }
const { tagName } = Astro.props
const declarations = (
  manifest as { modules: { declarations?: Declaration[] }[] }
).modules.flatMap((module) => module.declarations ?? [])
const declaration = declarations.find(
  (candidate) => candidate.tagName === tagName,
)
if (!declaration)
  throw new Error(
    `Unknown custom element requested by API reference: ${tagName}`,
  )
const properties = (declaration.members ?? []).filter(
  (member) => member.kind === 'field' && member.privacy === 'public',
)
const codeColumn = (key: string, label: string) => ({
  key,
  label,
  format: 'code' as const,
})
const sections = [
  {
    title: 'Attributes',
    columns: [
      codeColumn('name', 'Name'),
      codeColumn('property', 'Property'),
      codeColumn('type', 'Type'),
      codeColumn('default', 'Default'),
    ],
    rows: (declaration.attributes ?? []).map((item) => ({
      name: item.name,
      property: item.fieldName ?? '—',
      type: item.type?.text ?? 'unknown',
      default: item.default ?? '—',
    })),
  },
  {
    title: 'Properties',
    columns: [
      codeColumn('name', 'Name'),
      codeColumn('type', 'Type'),
      codeColumn('attribute', 'Attribute'),
      { key: 'reflected', label: 'Reflected' },
    ],
    rows: properties.map((item) => ({
      name: item.name,
      type: item.type?.text ?? 'unknown',
      attribute: item.attribute ?? '—',
      reflected: item.reflects ? 'yes' : 'no',
    })),
  },
  {
    title: 'Events',
    columns: [
      codeColumn('name', 'Name'),
      codeColumn('type', 'Type'),
      { key: 'description', label: 'Description' },
    ],
    rows: (declaration.events ?? []).map((item) => ({
      name: item.name,
      type: item.type?.text ?? 'CustomEvent',
      description: item.description ?? '—',
    })),
  },
  ...(
    [
      ['Slots', declaration.slots],
      ['CSS Parts', declaration.cssParts],
      ['CSS custom properties', declaration.cssProperties],
    ] as const
  ).map(([title, items]) => ({
    title,
    columns: [
      codeColumn('name', 'Name'),
      { key: 'description', label: 'Description' },
    ],
    rows: (items ?? []).map((item) => ({
      name: item.name || '(default)',
      description: item.description ?? '—',
    })),
  })),
]
const id = `${tagName}-api`
---

<section class="content-section api-reference" aria-labelledby={id}>
  <h2 id={id}>API reference: <code>{`<${tagName}>`}</code></h2>
  {
    sections
      .filter((section) => section.rows.length)
      .map((section) => (
        <Table
          class="api-reference-table"
          caption={section.title}
          columns={section.columns}
          rows={section.rows}
          density="compact"
          typography="body"
          variant="ruled"
          minWidth="28rem"
        />
      ))
  }
</section>
