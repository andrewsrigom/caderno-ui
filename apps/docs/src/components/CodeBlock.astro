---
import CodeSample from '@caderno-ui/astro/CodeBlock.astro'
type Props = {
  code: string
  collapsible?: boolean
  filename?: string
  language?: string
  open?: boolean
  showLineNumbers?: boolean
}

const {
  code,
  collapsible = false,
  filename,
  language = 'html',
  open = false,
  showLineNumbers = false,
} = Astro.props
---

{
  collapsible ? (
    <cad-accordion-item
      class="code-disclosure"
      data-code-disclosure
      heading={open ? 'Hide code' : 'Show code'}
      open={open || undefined}
      animation="none"
    >
      <CodeSample
        code={code}
        filename={filename}
        language={language}
        showLineNumbers={showLineNumbers}
        copyable
      />
    </cad-accordion-item>
  ) : (
    <div class="code-block">
      <CodeSample
        code={code}
        filename={filename}
        language={language}
        showLineNumbers={showLineNumbers}
        copyable
      />
    </div>
  )
}

<script>
  import '@caderno-ui/elements/accordion'
  import type { CadAccordionItem } from '@caderno-ui/elements/accordion'

  for (const disclosure of document.querySelectorAll<CadAccordionItem>(
    '[data-code-disclosure]',
  )) {
    disclosure.addEventListener('cad-accordion-toggle', () => {
      disclosure.heading = disclosure.open ? 'Hide code' : 'Show code'
    })
  }
</script>
