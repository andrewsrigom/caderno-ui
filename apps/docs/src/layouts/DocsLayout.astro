---
import '@caderno-ui/tokens/notebook.css'
import '../styles/global.css'

import { navigation } from '../lib/navigation'

type Props = {
  description: string
  title: string
}

const { description, title } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const toUrl = (href: string) => `${base}${href}`
const pagePath = Astro.url.pathname.slice(base.length) || '/'
const isActive = (href: string) =>
  href === '/' ? pagePath === '/' : pagePath.startsWith(href)
const fullTitle = title === 'Caderno UI' ? title : `${title} · Caderno UI`
const socialImage = new URL(`${base}/og.png`, Astro.site)
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f7fb" />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{fullTitle}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('caderno-ui:docs-theme')
      const preferredTheme = matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light'
      document.documentElement.dataset.theme = savedTheme ?? preferredTheme
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="topbar">
      <a class="brand" href={toUrl('/')} aria-label="Caderno UI home">
        <span aria-hidden="true" class="brand-mark">C</span>
        <span>
          <strong>Caderno UI</strong>
          <small>Notebook-native components</small>
        </span>
      </a>
      <nav aria-label="Utility navigation">
        <a href="https://www.npmjs.com/org/caderno-ui">npm</a>
        <a href="https://github.com/andrewsrigom/caderno-ui">GitHub</a>
        <button aria-label="Toggle color theme" data-theme-toggle type="button">
          <cad-icon name="spark" size="18"></cad-icon>
          <span>Theme</span>
        </button>
      </nav>
    </header>

    <details class="mobile-navigation">
      <summary>Documentation menu</summary>
      <nav aria-label="Mobile documentation">
        {
          navigation.map((section) => (
            <div>
              <strong>{section.label}</strong>
              {section.items.map((item) => (
                <a
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  href={toUrl(item.href)}
                >
                  {item.label}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </details>

    <div class="docs-shell">
      <aside class="sidebar">
        <nav aria-label="Documentation">
          {
            navigation.map((section) => (
              <section>
                <h2>{section.label}</h2>
                {section.items.map((item) => (
                  <a
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    href={toUrl(item.href)}
                  >
                    {item.label}
                  </a>
                ))}
              </section>
            ))
          }
        </nav>
        <p class="version-note">Current release <strong>v0.2.0</strong></p>
      </aside>

      <main id="content" tabindex="-1">
        <slot />
        <footer class="page-footer">
          <p>MIT licensed. Built with Lit, TypeScript, and Astro.</p>
          <a href="https://github.com/andrewsrigom/caderno-ui/issues"
            >Report an issue</a
          >
        </footer>
      </main>
    </div>

    <script>
      import '@caderno-ui/elements'

      const root = document.documentElement
      const themeButton = document.querySelector<HTMLButtonElement>(
        '[data-theme-toggle]',
      )

      themeButton?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light'
        localStorage.setItem(
          'caderno-ui:docs-theme',
          root.dataset.theme ?? 'light',
        )
      })

      for (const button of document.querySelectorAll<HTMLButtonElement>(
        '[data-copy-code]',
      )) {
        button.addEventListener('click', async () => {
          const codeBlock = button.closest('cad-code-block') as HTMLElement & {
            code?: string
          }
          const code = codeBlock?.code ?? codeBlock?.getAttribute('code')
          if (!code) return
          await navigator.clipboard.writeText(code)
          button.textContent = 'Copied'
          window.setTimeout(() => {
            button.textContent = 'Copy'
          }, 1400)
        })
      }
    </script>
  </body>
</html>
