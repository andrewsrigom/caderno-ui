---
import '@fontsource/caveat/latin-500.css'
import '@fontsource/caveat/latin-700.css'
import handRegular from '@fontsource/caveat/files/caveat-latin-500-normal.woff2?url'
import handStrong from '@fontsource/caveat/files/caveat-latin-700-normal.woff2?url'
import '@caderno-ui/tokens/notebook.css'
import '@caderno-ui/elements/scrollbar.css'
import '@caderno-ui/elements/typography.css'
import '../styles/global.css'

import Button from '@caderno-ui/astro/Button.astro'
import Drawer from '@caderno-ui/astro/Drawer.astro'
import Footer from '@caderno-ui/astro/Footer.astro'
import Header from '@caderno-ui/astro/Header.astro'
import Icon from '@caderno-ui/astro/Icon.astro'
import Link from '@caderno-ui/astro/Link.astro'
import DocsNavigation from '../components/DocsNavigation.astro'
import DocsSidebar from '../components/DocsSidebar.astro'

type Props = {
  description: string
  title: string
}

const { description, title } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const toUrl = (href: string) => `${base}${href}`
const fullTitle = title === 'Caderno UI' ? title : `${title} · Caderno UI`
const socialImage = new URL(`${base}/og.png`, Astro.site)
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link
      rel="preload"
      href={handRegular}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={handStrong}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{fullTitle}</title>
    <script is:inline>
      let savedTheme
      try {
        savedTheme = localStorage.getItem('caderno-ui:docs-theme')
      } catch {}
      document.documentElement.dataset.theme =
        savedTheme === 'dark' ? 'dark' : 'light'
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header class="docs-header" label="Caderno UI" variant="glass" sticky>
      <div slot="brand" class="docs-brand-row">
        <Drawer
          class="docs-mobile-menu"
          heading="Documentation"
          closeLabel="Close documentation menu"
          placement="left"
          size="sm"
        >
          <Button
            slot="trigger"
            label="Open documentation menu"
            size="sm"
            variant="ghost"
          >
            Menu
          </Button>
          <DocsNavigation label="Mobile documentation" />
        </Drawer>
        <a class="docs-brand" href={toUrl('/')} aria-label="Caderno UI home"
          >Caderno UI</a
        >
      </div>
      <div slot="actions" class="docs-actions">
        <div class="docs-utility-links">
          <Link href="https://www.npmjs.com/org/caderno-ui">npm</Link>
          <Link href="https://github.com/andrewsrigom/caderno-ui">GitHub</Link>
        </div>
        <span data-theme-toggle>
          <Button label="Toggle color theme" size="sm" variant="ghost">
            <Icon slot="start" name="spark" size={18} />Theme
          </Button>
        </span>
      </div>
    </Header>
    <noscript>
      <div class="docs-mobile-menu docs-nojs-navigation">
        <DocsNavigation label="Mobile documentation" />
      </div>
      <style>
        [data-theme-toggle],
        cad-drawer.docs-mobile-menu {
          display: none !important;
        }
      </style>
    </noscript>

    <div class="docs-shell">
      <DocsSidebar />

      <main id="content" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer class="docs-footer" label="Caderno UI footer" variant="minimal">
      <div slot="bottom" class="docs-footer-content">
        <span>MIT licensed. Built with Caderno UI.</span>
        <Link href="https://github.com/andrewsrigom/caderno-ui/issues"
          >Report an issue</Link
        >
      </div>
      <Link slot="back-to-top" href="#content">Back to top</Link>
    </Footer>

    <script>
      const root = document.documentElement
      const themeButton = document.querySelector<HTMLElement>(
        '[data-theme-toggle]',
      )

      themeButton?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light'
        try {
          localStorage.setItem(
            'caderno-ui:docs-theme',
            root.dataset.theme ?? 'light',
          )
        } catch {
          /* A blocked preference store must not prevent toggling. */
        }
      })
    </script>
  </body>
</html>
