---
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-alert heading="Review the API" variant="warning" dismissible>
  Public behavior needs a public contract.
</cad-alert>

<script type="module">
  import '@caderno-ui/elements/alert'
</script>`

const eventCode = `document.addEventListener('cad-dismiss', (event) => {
  console.log(event.detail.variant) // "warning"
})`
---

<DocsLayout
  description="CadAlert displays notebook-styled status messages with semantic roles and optional dismissal."
  title="Alert"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-alert&gt;</p>
    <h1>A note that earns attention.</h1>
    <p>
      Alert communicates informational, successful, cautionary, and dangerous
      states. Its semantic role follows the urgency of the selected variant.
    </p>
  </header>

  <DemoFrame title="Alert variants">
    <cad-alert heading="Information" variant="info">
      Useful context that does not interrupt the workflow.
    </cad-alert>
    <cad-alert heading="Everything passed" variant="success">
      The package contract and browser behavior agree.
    </cad-alert>
    <cad-alert dismissible heading="Review this" variant="warning">
      A cautionary state announces itself as an alert.
    </cad-alert>
    <cad-alert heading="Build failed" variant="danger">
      A blocking problem that requires action.
    </cad-alert>
  </DemoFrame>
  <CodeBlock code={usage} language="html" />

  <section class="content-section" aria-labelledby="attributes-title">
    <h2 id="attributes-title">Attributes</h2>
    <table class="api-table">
      <thead
        ><tr><th>Name</th><th>Type</th><th>Default</th><th>Purpose</th></tr
        ></thead
      >
      <tbody>
        <tr
          ><td><code>variant</code></td><td
            ><code>info | success | warning | danger</code></td
          ><td><code>info</code></td><td
            >Visual treatment and semantic urgency.</td
          ></tr
        >
        <tr
          ><td><code>heading</code></td><td><code>string</code></td><td
            >empty</td
          ><td>Fallback heading when the title slot is unused.</td></tr
        >
        <tr
          ><td><code>dismissible</code></td><td><code>boolean</code></td><td
            ><code>false</code></td
          ><td>Shows the dismiss action.</td></tr
        >
        <tr
          ><td><code>dismiss-label</code></td><td><code>string</code></td><td
            ><code>Dismiss alert</code></td
          ><td>Accessible label for the dismiss button.</td></tr
        >
      </tbody>
    </table>
  </section>

  <section class="content-section" aria-labelledby="events-title">
    <h2 id="events-title">Events</h2>
    <p>
      <code class="inline-code">cad-dismiss</code> bubbles and is composed. Its detail
      is <code class="inline-code">{'{ variant }'}</code>.
    </p>
    <CodeBlock code={eventCode} language="typescript" />
  </section>

  <section class="content-section" aria-labelledby="styling-title">
    <h2 id="styling-title">Slots and styling</h2>
    <table class="api-table">
      <thead><tr><th>Surface</th><th>Names</th></tr></thead>
      <tbody>
        <tr><td>Slots</td><td>default body, <code>title</code></td></tr>
        <tr
          ><td>CSS parts</td><td
            ><code>base</code>, <code>close-button</code>, <code>content</code>, <code
              >icon</code
            >, <code>title</code></td
          ></tr
        >
        <tr
          ><td>CSS properties</td><td
            ><code>--cad-alert-bg</code>, <code>--cad-alert-ink</code></td
          ></tr
        >
      </tbody>
    </table>
  </section>
</DocsLayout>
