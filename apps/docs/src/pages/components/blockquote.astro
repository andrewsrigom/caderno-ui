---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import ExampleCard from '../../components/ExampleCard.astro'
import ExampleGallery from '../../components/ExampleGallery.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-blockquote
  author="Review team"
  source="Search review (example)"
>
  Search should stay available while the index rebuilds.
</cad-blockquote>

<script type="module">
  import '@caderno-ui/elements/blockquote'
</script>`

const variantsUsage = `<cad-blockquote>
  Leave time to check the results before the next release.
</cad-blockquote>

<cad-blockquote author="Review team" tone="lemon" variant="highlight">
  Start with the slowest query.
</cad-blockquote>`
---

<DocsLayout
  description="Display a quotation with optional author and source."
  title="Blockquote"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-blockquote&gt;</p>
    <h1>Blockquote</h1>
    <p>Display a quotation with optional author and source.</p>
  </header>

  <DemoFrame
    title="With source"
    description="Sample quotations from a fictional project review."
  >
    <cad-blockquote author="Review team" source="Search review (example)">
      Search should stay available while the index rebuilds.
    </cad-blockquote>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ExampleGallery id="quote-variants-title" title="Attribution and emphasis">
    <ExampleCard title="Without attribution">
      <cad-blockquote class="gallery-quote">
        Leave time to check the results before the next release.
      </cad-blockquote>
    </ExampleCard>
    <ExampleCard title="Highlighted takeaway">
      <cad-blockquote
        class="gallery-quote"
        author="Review team"
        tone="lemon"
        variant="highlight"
      >
        Start with the slowest query.
      </cad-blockquote>
    </ExampleCard>
  </ExampleGallery>
  <CodeBlock code={variantsUsage} collapsible language="html" />

  <section class="content-section" aria-labelledby="quote-highlight">
    <h2 id="quote-highlight">Highlight</h2>
    <p>Use <code>variant="highlight"</code> to emphasize a key quotation.</p>
  </section>

  <ApiReference tagName="cad-blockquote" />

  <style>
    .gallery-quote {
      width: 100%;
    }
  </style>

  <section class="content-section" aria-labelledby="quote-accessibility">
    <h2 id="quote-accessibility">Accessibility</h2>
    <p>
      Use Blockquote for quoted material. Use the <code>caption</code> slot for formatted
      attribution and <code>cite</code> for the source URL.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/blockquote'
</script>
