---
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import ExampleCard from '../../components/ExampleCard.astro'
import ExampleGallery from '../../components/ExampleGallery.astro'
import ApiReference from '../../components/ApiReference.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-bookmark
  bookmark-id="architecture-notes"
  label="Save note"
  active-label="Remove saved note"
  persist
></cad-bookmark>

<script type="module">
  import '@caderno-ui/elements/bookmark'
</script>`
const eventCode = `bookmark.addEventListener('cad-bookmark-change', (event) => {
  const { active, id } = event.detail
  console.log({ active, id })
})`
const statesUsage = `<cad-bookmark label="Save note"></cad-bookmark>
<cad-bookmark
  active-label="Remove saved note"
  bookmarked
  label="Save note"
></cad-bookmark>`
---

<DocsLayout
  description="Save or unsave an item. Optionally remember the choice on this device."
  title="Bookmark"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-bookmark&gt;</p>
    <h1>Bookmark</h1>
    <p>
      Save or unsave an item. Optionally remember the choice on this device.
    </p>
  </header>

  <DemoFrame
    title="Persistent bookmark"
    description="Reload the page after toggling; this example keeps its state locally."
  >
    <cad-bookmark
      active-label="Remove saved note"
      bookmark-id="architecture-notes"
      label="Save note"
      persist></cad-bookmark>
    <output class="event-output" data-bookmark-output aria-live="polite">
      Toggle the bookmark to inspect its event detail.
    </output>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ExampleGallery
    id="bookmark-states-title"
    title="Saved and unsaved"
    description="Saving to local storage is optional."
  >
    <ExampleCard title="Not saved">
      <cad-bookmark label="Save note"></cad-bookmark>
    </ExampleCard>
    <ExampleCard title="Saved">
      <cad-bookmark
        active-label="Remove saved note"
        bookmarked
        label="Save note"></cad-bookmark>
    </ExampleCard>
  </ExampleGallery>
  <CodeBlock code={statesUsage} collapsible language="html" />

  <ApiReference tagName="cad-bookmark" />

  <section class="content-section" aria-labelledby="events-title">
    <h2 id="events-title">Events</h2>
    <p>
      <code>cad-bookmark-change</code> reports <code>{'{ active, id }'}</code> and
      bubbles to parent elements.
    </p>
    <CodeBlock code={eventCode} language="typescript" />
  </section>

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      The button exposes <code>aria-pressed</code>. Give both states clear
      labels, such as “Save note” and “Remove saved note”.
    </p>
  </section>

  <script>
    const bookmark = document.querySelector(
      'cad-bookmark[bookmark-id="architecture-notes"]',
    )
    const output = document.querySelector('[data-bookmark-output]')
    bookmark?.addEventListener('cad-bookmark-change', (event) => {
      if (!(event instanceof CustomEvent) || !output) return
      output.textContent = JSON.stringify(event.detail)
    })
  </script>
</DocsLayout>

<script>
  import '@caderno-ui/elements/bookmark'
</script>
