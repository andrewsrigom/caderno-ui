---
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-bookmark
  bookmark-id="architecture-notes"
  label="Save note"
  active-label="Remove saved note"
  persist
></cad-bookmark>

<script type="module">
  import '@caderno-ui/elements/bookmark'
</script>`
const eventCode = `bookmark.addEventListener('cad-bookmark-change', (event) => {
  const { active, id } = event.detail
  console.log({ active, id })
})`
---

<DocsLayout
  description="CadBookmark is an accessible pressed-state control with optional local persistence."
  title="Bookmark"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-bookmark&gt;</p>
    <h1>Save a place without hiding the state.</h1>
    <p>
      Bookmark wraps a native toggle button, exposes its pressed state, and can
      optionally remember that state in local storage.
    </p>
  </header>

  <DemoFrame
    title="Persistent bookmark"
    description="Reload the page after toggling; this example keeps its state locally."
  >
    <cad-bookmark
      active-label="Remove saved note"
      bookmark-id="docs-bookmark-demo"
      label="Save note"
      persist></cad-bookmark>
    <output class="event-output" data-bookmark-output aria-live="polite">
      Toggle the bookmark to inspect its event detail.
    </output>
  </DemoFrame>
  <CodeBlock code={usage} language="html" />

  <section class="content-section" aria-labelledby="attributes-title">
    <h2 id="attributes-title">Attributes</h2>
    <table class="api-table">
      <thead
        ><tr><th>Name</th><th>Type</th><th>Default</th><th>Purpose</th></tr
        ></thead
      >
      <tbody>
        <tr
          ><td><code>bookmark-id</code></td><td><code>string</code></td><td
            >empty</td
          ><td>Identity included in events and storage keys.</td></tr
        >
        <tr
          ><td><code>bookmarked</code></td><td><code>boolean</code></td><td
            ><code>false</code></td
          ><td>Current pressed state.</td></tr
        >
        <tr
          ><td><code>label</code></td><td><code>string</code></td><td
            ><code>Save bookmark</code></td
          ><td>Label for the inactive state.</td></tr
        >
        <tr
          ><td><code>active-label</code></td><td><code>string</code></td><td
            ><code>Remove bookmark</code></td
          ><td>Label for the active state.</td></tr
        >
        <tr
          ><td><code>persist</code></td><td><code>boolean</code></td><td
            ><code>false</code></td
          ><td>Persists state in local storage.</td></tr
        >
        <tr
          ><td><code>storage-prefix</code></td><td><code>string</code></td><td
            ><code>caderno-ui:bookmark</code></td
          ><td>Namespaces the local storage key.</td></tr
        >
      </tbody>
    </table>
  </section>

  <section class="content-section" aria-labelledby="events-title">
    <h2 id="events-title">Events</h2>
    <p>
      <code class="inline-code">cad-bookmark-change</code> exposes
      <code class="inline-code">{'{ active, id }'}</code> and crosses the shadow boundary.
    </p>
    <CodeBlock code={eventCode} language="typescript" />
  </section>

  <section class="content-section" aria-labelledby="styling-title">
    <h2 id="styling-title">Slots and styling</h2>
    <table class="api-table">
      <thead><tr><th>Surface</th><th>Names</th></tr></thead>
      <tbody>
        <tr
          ><td>Slots</td><td><code>fallback</code> for pre-upgrade content</td
          ></tr
        >
        <tr
          ><td>CSS parts</td><td
            ><code>button</code>, <code>icon</code>, <code>label</code></td
          ></tr
        >
        <tr
          ><td>CSS properties</td><td
            ><code>--cad-bookmark-bg</code>, <code>--cad-bookmark-ink</code></td
          ></tr
        >
      </tbody>
    </table>
  </section>

  <script>
    const bookmark = document.querySelector(
      'cad-bookmark[bookmark-id="docs-bookmark-demo"]',
    )
    const output = document.querySelector('[data-bookmark-output]')
    bookmark?.addEventListener('cad-bookmark-change', (event) => {
      if (!(event instanceof CustomEvent) || !output) return
      output.textContent = JSON.stringify(event.detail)
    })
  </script>
</DocsLayout>
