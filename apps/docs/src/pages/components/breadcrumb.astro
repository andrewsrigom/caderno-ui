---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-breadcrumb label="Architecture guide path">
  <cad-breadcrumb-item href="/guides">Guides</cad-breadcrumb-item>
  <cad-breadcrumb-item href="/guides/system-design">
    System design
  </cad-breadcrumb-item>
  <cad-breadcrumb-item href="/guides/system-design/caching">
    Caching
  </cad-breadcrumb-item>
  <cad-breadcrumb-item current>Trade-offs</cad-breadcrumb-item>
</cad-breadcrumb>

<script type="module">
  import '@caderno-ui/elements/breadcrumb'
</script>`
---

<DocsLayout
  description="Show the current page and links to its parent pages."
  title="Breadcrumb"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-breadcrumb&gt;</p>
    <h1>Breadcrumb</h1>
    <p>Show the current page and links to its parent pages.</p>
  </header>

  <DemoFrame title="Architecture guide path">
    <cad-breadcrumb label="Architecture guide path">
      <cad-breadcrumb-item href="/guides">Guides</cad-breadcrumb-item>
      <cad-breadcrumb-item href="/guides/system-design"
        >System design</cad-breadcrumb-item
      >
      <cad-breadcrumb-item href="/guides/system-design/caching"
        >Caching</cad-breadcrumb-item
      >
      <cad-breadcrumb-item current>Trade-offs</cad-breadcrumb-item>
    </cad-breadcrumb>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />
  <ApiReference tagName="cad-breadcrumb" />
  <ApiReference tagName="cad-breadcrumb-item" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      The trail is a labeled navigation list. Parent pages are links; the
      current page uses <code>aria-current="page"</code>.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/breadcrumb'
</script>
