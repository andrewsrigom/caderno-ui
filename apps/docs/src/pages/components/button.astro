---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const usage = `<cad-button tone="blue">
  <cad-icon aria-hidden="true" name="check" size="18" slot="start"></cad-icon>
  Save review
</cad-button>

<cad-button tone="lemon" variant="secondary">
  <cad-icon aria-hidden="true" name="spark" size="18" slot="start"></cad-icon>
  Save draft
</cad-button>

<cad-button href="/components/" variant="ghost">
  Browse components
  <cad-icon aria-hidden="true" name="arrow-right" size="18" slot="end"></cad-icon>
</cad-button>

<cad-button size="sm" tone="coral" variant="link">
  Read the contract
</cad-button>

<script type="module">
  import '@caderno-ui/elements/button'
  import '@caderno-ui/elements/icon'
</script>`
---

<DocsLayout
  description="Trigger an action, submit a form, or navigate to a page. Add icons through slots."
  title="Button"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-button&gt;</p>
    <h1>Button</h1>
    <p>
      Trigger an action, submit a form, or navigate to a page. Add icons through
      slots.
    </p>
  </header>

  <DemoFrame title="Actions">
    <div class="demo-row">
      <cad-button tone="blue">
        <cad-icon aria-hidden="true" name="check" size="18" slot="start"
        ></cad-icon>
        Save review
      </cad-button>
      <cad-button tone="lemon" variant="secondary">
        <cad-icon aria-hidden="true" name="spark" size="18" slot="start"
        ></cad-icon>
        Save draft
      </cad-button>
      <cad-button href={`${base}/components/`} variant="ghost">
        Browse components
        <cad-icon aria-hidden="true" name="arrow-right" size="18" slot="end"
        ></cad-icon>
      </cad-button>
      <cad-button size="sm" tone="coral" variant="link"
        >Read the contract</cad-button
      >
    </div>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ApiReference tagName="cad-button" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Usage and accessibility</h2>
    <p>
      Use visible text, or <code>label</code> for icon-only buttons. Set <code
        >href</code
      > for navigation and <code>type="submit"</code> or <code
        >type="reset"</code
      > for form actions. Disabled buttons and links cannot be activated.
    </p>
  </section>

  <style>
    .demo-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      align-items: center;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/button'
  import '@caderno-ui/elements/icon'
</script>
