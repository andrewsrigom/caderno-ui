---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-button tone="mint">
  <cad-icon aria-hidden="true" name="check" slot="start"></cad-icon>
  Save review
</cad-button>
<cad-button href="/components" variant="secondary">Browse components</cad-button>

<script type="module">
  import '@caderno-ui/elements/button'
  import '@caderno-ui/elements/icon'
</script>`
---

<DocsLayout
  description="CadButton renders a native button or anchor with notebook styling and form-aware submit behavior."
  title="Button"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-button&gt;</p>
    <h1>Make the action obvious without losing native behavior.</h1>
    <p>
      Button selects a native button or anchor from its contract, supports form
      submission across the shadow boundary, and keeps disabled links out of the
      tab order. Leading and trailing content are slots, so Button does not load
      the icon catalog unless the application chooses one.
    </p>
  </header>

  <DemoFrame
    title="A realistic action group"
    description="Primary save, secondary draft, navigation, and a low-emphasis reference use native semantics."
  >
    <div class="demo-row">
      <cad-button tone="mint">
        <cad-icon aria-hidden="true" name="check" size="18" slot="start"
        ></cad-icon>
        Save review
      </cad-button>
      <cad-button tone="lemon" variant="secondary">
        <cad-icon aria-hidden="true" name="spark" size="18" slot="start"
        ></cad-icon>
        Save draft
      </cad-button>
      <cad-button href="/caderno-ui/components/" variant="ghost">
        Browse components
        <cad-icon aria-hidden="true" name="arrow-right" size="18" slot="end"
        ></cad-icon>
      </cad-button>
      <cad-button size="sm" tone="coral" variant="link"
        >Read the contract</cad-button
      >
    </div>
  </DemoFrame>
  <CodeBlock code={usage} language="html" />

  <ApiReference tagName="cad-button" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      Visible text is the preferred accessible name. Supply <code>label</code>
      for icon-only actions. Use <code>href</code> for navigation and a button without
      <code>href</code> for actions; visual variants never change that semantic distinction.
    </p>
  </section>

  <style>
    .demo-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      align-items: center;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/button'
  import '@caderno-ui/elements/icon'
</script>
