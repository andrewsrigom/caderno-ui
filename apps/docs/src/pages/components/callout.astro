---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import ExampleCard from '../../components/ExampleCard.astro'
import ExampleGallery from '../../components/ExampleGallery.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const usage = `<cad-callout heading="Add a source link" variant="tip">
  Link to the original article so you can find it again later.
  <a href="${base}/composition/" slot="action">Read the guide</a>
</cad-callout>

<script type="module">
  import '@caderno-ui/elements/callout'
</script>`

const variantsUsage = `<cad-callout heading="Context" variant="info">
  These notes cover the first chapter.
</cad-callout>
<cad-callout heading="Review complete" variant="success">
  All source links have been checked.
</cad-callout>
<cad-callout heading="Check the date" variant="warning">
  The next review has moved to Friday.
</cad-callout>
<cad-callout heading="Do not publish" variant="danger">
  Remove the private contact details before sharing these notes.
</cad-callout>`
---

<DocsLayout
  description="Add a tip, note, or warning to the page. Use Alert for status changes."
  title="Callout"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-callout&gt;</p>
    <h1>Callout</h1>
    <p>
      Add a tip, note, or warning to the page. Use Alert for status changes.
    </p>
  </header>

  <DemoFrame title="A page note">
    <cad-callout heading="Add a source link" variant="tip">
      Link to the original article so you can find it again later.
      <a href={`${base}/composition/`} slot="action">Read the guide</a>
    </cad-callout>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ExampleGallery id="callout-variants-title" title="Message variants">
    <ExampleCard title="Info">
      <cad-callout class="gallery-callout" heading="Context" variant="info">
        These notes cover the first chapter.
      </cad-callout>
    </ExampleCard>
    <ExampleCard title="Success">
      <cad-callout
        class="gallery-callout"
        heading="Review complete"
        variant="success"
      >
        All source links have been checked.
      </cad-callout>
    </ExampleCard>
    <ExampleCard title="Warning">
      <cad-callout
        class="gallery-callout"
        heading="Check the date"
        variant="warning"
      >
        The next review has moved to Friday.
      </cad-callout>
    </ExampleCard>
    <ExampleCard title="Danger">
      <cad-callout
        class="gallery-callout"
        heading="Do not publish"
        variant="danger"
      >
        Remove the private contact details before sharing these notes.
      </cad-callout>
    </ExampleCard>
  </ExampleGallery>
  <CodeBlock code={variantsUsage} collapsible language="html" />

  <ApiReference tagName="cad-callout" />

  <style>
    .gallery-callout {
      width: 100%;
    }
  </style>

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      Callout is ordinary page content, not a live announcement. Explain the
      message in text rather than color alone.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/callout'
</script>
