---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import ExampleCard from '../../components/ExampleCard.astro'
import ExampleGallery from '../../components/ExampleGallery.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-callout heading="Keep the contract small" variant="tip">
  Add a property only when composition and native semantics cannot express the requirement.
  <a href="/composition/" slot="action">Read the guide</a>
</cad-callout>

<script type="module">
  import '@caderno-ui/elements/callout'
</script>`

const variantsUsage = `<cad-callout heading="Context" variant="info">
  This decision applies to new integrations only.
</cad-callout>
<cad-callout heading="Good default" variant="success">
  Prefer composition before adding another property.
</cad-callout>
<cad-callout heading="Check the trade-off" variant="warning">
  This shortcut increases the migration cost later.
</cad-callout>
<cad-callout heading="Do not publish" variant="danger">
  The example still contains a private token.
</cad-callout>`
---

<DocsLayout
  description="Add a tip, note, or warning to the page. Use Alert for status changes."
  title="Callout"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-callout&gt;</p>
    <h1>Callout</h1>
    <p>
      Add a tip, note, or warning to the page. Use Alert for status changes.
    </p>
  </header>

  <DemoFrame title="A page note">
    <cad-callout heading="Keep the contract small" variant="tip">
      Add a property only when composition and native semantics cannot express
      the requirement.
      <a href="/composition/" slot="action">Read the guide</a>
    </cad-callout>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ExampleGallery id="callout-variants-title" title="Message variants">
    <ExampleCard title="Info">
      <cad-callout class="gallery-callout" heading="Context" variant="info">
        This decision applies to new integrations only.
      </cad-callout>
    </ExampleCard>
    <ExampleCard title="Success">
      <cad-callout
        class="gallery-callout"
        heading="Good default"
        variant="success"
      >
        Prefer composition before adding another property.
      </cad-callout>
    </ExampleCard>
    <ExampleCard title="Warning">
      <cad-callout
        class="gallery-callout"
        heading="Check the trade-off"
        variant="warning"
      >
        This shortcut increases the migration cost later.
      </cad-callout>
    </ExampleCard>
    <ExampleCard title="Danger">
      <cad-callout
        class="gallery-callout"
        heading="Do not publish"
        variant="danger"
      >
        The example still contains a private token.
      </cad-callout>
    </ExampleCard>
  </ExampleGallery>
  <CodeBlock code={variantsUsage} collapsible language="html" />

  <ApiReference tagName="cad-callout" />

  <style>
    .gallery-callout {
      width: 100%;
    }
  </style>

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      Callout is ordinary page content, not a live announcement. Explain the
      message in text rather than color alone.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/callout'
</script>
