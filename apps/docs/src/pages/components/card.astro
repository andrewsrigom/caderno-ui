---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-card tone="blue">
  <cad-card-header>
    <cad-card-title>
      <h2>Search indexing strategy</h2>
    </cad-card-title>
  </cad-card-header>
  <cad-card-content>
    <p>
      Compare write amplification, query latency, and failure recovery
      before choosing the index boundary.
    </p>
  </cad-card-content>
  <cad-card-footer>
    <cad-badge tone="mint">Ready for review</cad-badge>
    <time datetime="2026-08-24">Updated today</time>
  </cad-card-footer>
</cad-card>

<script type="module">
  import '@caderno-ui/elements/card'
  import '@caderno-ui/elements/badge'
</script>`

const plainUsage = `<cad-card tone="blue" variant="plain">
  <cad-card-header>
    <cad-card-title><h2>Review confidence</h2></cad-card-title>
  </cad-card-header>
  <cad-card-content>
    <p>
      Scope, options, and evidence are ready. The decision can move
      forward without adding another boxed surface to the page.
    </p>
  </cad-card-content>
  <cad-card-footer>
    <span>3 checkpoints complete</span>
    <time datetime="2026-08-24">Updated today</time>
  </cad-card-footer>
</cad-card>`
---

<DocsLayout
  description="Group related content. Add only the header, title, body, and footer you need."
  title="Card"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-card&gt; family</p>
    <h1>Card</h1>
    <p>
      Group related content. Add only the header, title, body, and footer you
      need.
    </p>
  </header>

  <DemoFrame title="With an outer border">
    <div class="card-stage">
      <cad-card tone="blue">
        <cad-card-header>
          <cad-card-title>
            <h2>Search indexing strategy</h2>
          </cad-card-title>
        </cad-card-header>
        <cad-card-content>
          <p>
            Compare write amplification, query latency, and failure recovery
            before choosing the index boundary.
          </p>
        </cad-card-content>
        <cad-card-footer>
          <cad-badge tone="mint">Ready for review</cad-badge>
          <time datetime="2026-08-24">Updated today</time>
        </cad-card-footer>
      </cad-card>
    </div>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <DemoFrame
    title="Without an outer border"
    description="The plain variant keeps the section dividers."
  >
    <div class="card-stage">
      <cad-card tone="blue" variant="plain">
        <cad-card-header>
          <cad-card-title><h2>Review confidence</h2></cad-card-title>
        </cad-card-header>
        <cad-card-content>
          <p>
            Scope, options, and evidence are ready. The decision can move
            forward without adding another boxed surface to the page.
          </p>
        </cad-card-content>
        <cad-card-footer>
          <span>3 checkpoints complete</span>
          <time datetime="2026-08-24">Updated today</time>
        </cad-card-footer>
      </cad-card>
    </div>
  </DemoFrame>
  <CodeBlock code={plainUsage} collapsible language="html" />

  <section class="content-section" aria-labelledby="composition-title">
    <h2 id="composition-title">Composition</h2>
    <p>
      Put a native heading inside <code>cad-card-title</code> to choose its heading
      level. Import icons and badges separately when using them.
    </p>
    <p>
      The default <code>paper</code> variant has an outer border. Use <code
        >variant="plain"</code
      > for section dividers only. Add <code>folded</code> for a folded corner.
    </p>
  </section>

  <ApiReference tagName="cad-card" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      Do not nest buttons or links inside a linked card. For multiple actions,
      omit <code>href</code> and put controls in <code>cad-card-footer</code>.
    </p>
  </section>

  <style>
    .card-stage {
      width: min(100%, 46rem);
      margin-inline: auto;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/badge'
  import '@caderno-ui/elements/card'
</script>
