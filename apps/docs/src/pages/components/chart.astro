---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import ExampleCard from '../../components/ExampleCard.astro'
import ExampleGallery from '../../components/ExampleGallery.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-chart heading="Notes reviewed" type="bar" value-label="Notes">
  <cad-chart-item label="Mon" value="4">Mon: 4</cad-chart-item>
  <cad-chart-item label="Tue" value="7">Tue: 7</cad-chart-item>
  <cad-chart-item label="Wed" value="5">Wed: 5</cad-chart-item>
  <cad-chart-item label="Thu" value="9">Thu: 9</cad-chart-item>
  <cad-chart-item label="Fri" value="6">Fri: 6</cad-chart-item>
</cad-chart>

<script type="module">
  import '@caderno-ui/elements/chart'
</script>`

const variantsUsage = `<cad-chart animation="none" heading="Study progress" type="line" value-label="Score">
  <cad-chart-item label="Week 1" value="38">Week 1: 38</cad-chart-item>
  <cad-chart-item label="Week 2" value="52">Week 2: 52</cad-chart-item>
  <cad-chart-item label="Week 3" value="61">Week 3: 61</cad-chart-item>
  <cad-chart-item label="Week 4" value="78">Week 4: 78</cad-chart-item>
  <cad-chart-item label="Week 5" value="86">Week 5: 86</cad-chart-item>
</cad-chart>

<cad-chart animation="none" heading="Review outcome" show-legend type="donut" value-label="Notes">
  <cad-chart-item label="Approved" value="8">Approved: 8</cad-chart-item>
  <cad-chart-item label="Changes" value="3">Changes requested: 3</cad-chart-item>
  <cad-chart-item label="Blocked" value="1">Blocked: 1</cad-chart-item>
</cad-chart>`
---

<DocsLayout
  description="Compare values with bars, follow changes with lines, or show proportions with a donut. Each chart includes an accessible data table."
  title="Chart"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-chart&gt; + &lt;cad-chart-item&gt;</p>
    <h1>Chart</h1>
    <p>
      Compare values with bars, follow changes with lines, or show proportions
      with a donut. Each chart includes an accessible data table.
    </p>
  </header>

  <DemoFrame title="Notes reviewed" description="Use bars to compare values.">
    <cad-chart heading="Notes reviewed" type="bar" value-label="Notes">
      <cad-chart-item label="Mon" value="4">Mon: 4</cad-chart-item>
      <cad-chart-item label="Tue" value="7">Tue: 7</cad-chart-item>
      <cad-chart-item label="Wed" value="5">Wed: 5</cad-chart-item>
      <cad-chart-item label="Thu" value="9">Thu: 9</cad-chart-item>
      <cad-chart-item label="Fri" value="6">Fri: 6</cad-chart-item>
    </cad-chart>
  </DemoFrame>

  <CodeBlock code={usage} collapsible language="html" />

  <ExampleGallery
    id="chart-types-title"
    title="Chart types"
    description="All types use the same data format."
  >
    <ExampleCard
      title="Line · ordered change"
      description="Use lines to show change over a sequence."
    >
      <cad-chart
        animation="none"
        class="chart-variant"
        heading="Study progress"
        type="line"
        value-label="Score"
      >
        <cad-chart-item label="Week 1" value="38">Week 1: 38</cad-chart-item>
        <cad-chart-item label="Week 2" value="52">Week 2: 52</cad-chart-item>
        <cad-chart-item label="Week 3" value="61">Week 3: 61</cad-chart-item>
        <cad-chart-item label="Week 4" value="78">Week 4: 78</cad-chart-item>
        <cad-chart-item label="Week 5" value="86">Week 5: 86</cad-chart-item>
      </cad-chart>
    </ExampleCard>
    <ExampleCard
      title="Donut · part to whole"
      description="Use a donut for a few parts of a meaningful total."
    >
      <cad-chart
        animation="none"
        class="chart-variant"
        heading="Review outcome"
        show-legend
        type="donut"
        value-label="Notes"
      >
        <cad-chart-item label="Approved" value="8">Approved: 8</cad-chart-item>
        <cad-chart-item label="Changes" value="3">
          Changes requested: 3
        </cad-chart-item>
        <cad-chart-item label="Blocked" value="1">Blocked: 1</cad-chart-item>
      </cad-chart>
    </ExampleCard>
  </ExampleGallery>
  <CodeBlock code={variantsUsage} collapsible language="html" />

  <section class="content-section" aria-labelledby="loading-title">
    <h2 id="loading-title">Import</h2>
    <p>
      Import <code>@caderno-ui/elements/chart</code>, or its React or Astro
      adapter. Charts and Rough.js are not included in the elements root import.
    </p>
  </section>

  <section class="content-section" aria-labelledby="motion-title">
    <h2 id="motion-title">Animation</h2>
    <p>
      Charts animate when they enter the viewport or their data changes. Call <code
        >replay()</code
      > to repeat, or set <code>animation="none"</code> to disable. Reduced-motion
      preferences are respected.
    </p>
  </section>

  <ApiReference tagName="cad-chart" />
  <ApiReference tagName="cad-chart-item" />

  <section class="content-section" aria-labelledby="choosing-title">
    <h2 id="choosing-title">Data and labels</h2>
    <p>
      Keep labels short and add units with <code>value-label</code>. Negative
      values are clamped to zero.
    </p>
  </section>

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      A native table exposes the chart data to assistive technology. The SVG is
      decorative, and item text stays readable before JavaScript loads.
    </p>
  </section>

  <script>
    import '@caderno-ui/elements/chart'
  </script>

  <style>
    .chart-variant {
      width: 100%;
    }
  </style>
</DocsLayout>
