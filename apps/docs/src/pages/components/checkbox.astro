---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-checkbox
  checked
  label="Public contract reviewed"
  name="review"
  value="api"
></cad-checkbox>

<cad-checkbox
  hint="Required before publication."
  label="Keyboard flow verified"
  name="keyboard"
  required
  value="yes"
></cad-checkbox>

<cad-checkbox
  label="Release published"
></cad-checkbox>

<script type="module">
  import '@caderno-ui/elements/checkbox'
</script>`
---

<DocsLayout
  description="Select independent options. Supports checked, unchecked, and indeterminate states."
  title="Checkbox"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-checkbox&gt;</p>
    <h1>Checkbox</h1>
    <p>
      Select independent options. Supports checked, unchecked, and indeterminate
      states.
    </p>
  </header>

  <DemoFrame title="Checklist states">
    <div class="choice-stack">
      <cad-checkbox
        checked
        label="Public contract reviewed"
        name="review"
        value="api"></cad-checkbox>
      <cad-checkbox
        hint="Required before publication."
        label="Keyboard flow verified"
        name="keyboard"
        required
        tone="blue"
        value="yes"></cad-checkbox>
      <cad-checkbox label="Release published"></cad-checkbox>
    </div>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />
  <ApiReference tagName="cad-checkbox" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      The text label toggles the checkbox. Space toggles it from the keyboard; <code
        >required</code
      > enables native validation. Only checked values are submitted.
    </p>
  </section>

  <style>
    .choice-stack {
      display: grid;
      gap: 0.35rem;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/checkbox'
</script>
