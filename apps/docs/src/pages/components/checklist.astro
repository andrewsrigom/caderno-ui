---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-checklist title="Do" variant="do" tone="mint">
  <cad-checklist-item>Import the component entrypoint you use.</cad-checklist-item>
  <cad-checklist-item>Choose native heading levels in application markup.</cad-checklist-item>
</cad-checklist>

<cad-checklist title="Don't" variant="dont" tone="coral">
  <cad-checklist-item>Import the root package for one button.</cad-checklist-item>
  <cad-checklist-item>Encode a whole product card in component props.</cad-checklist-item>
</cad-checklist>

<script type="module">
  import '@caderno-ui/elements/checklist'
</script>`
---

<DocsLayout
  description="Composable checklists and do/don't guidance with intrinsic status marks."
  title="Checklist"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-checklist&gt; family</p>
    <h1>Review guidance that reads like a list.</h1>
    <p>
      The parent establishes tone and a default mark. Each item remains a small
      compound child and can override its own meaning in a mixed checklist.
    </p>
  </header>

  <DemoFrame
    title="Component API review"
    description="A concrete do/don't review used before accepting a new public contract."
  >
    <div class="guidance-grid">
      <cad-checklist title="Do" variant="do" tone="mint">
        <cad-checklist-item>
          Import the component entrypoint you actually use.
        </cad-checklist-item>
        <cad-checklist-item>
          Choose native heading levels in application markup.
        </cad-checklist-item>
        <cad-checklist-item>
          Keep optional icons in explicit slots.
        </cad-checklist-item>
      </cad-checklist>
      <cad-checklist title="Don't" variant="dont" tone="coral">
        <cad-checklist-item>
          Import the root package for one button.
        </cad-checklist-item>
        <cad-checklist-item>
          Encode a whole product card in component props.
        </cad-checklist-item>
        <cad-checklist-item>
          Replace native semantics with decorative containers.
        </cad-checklist-item>
      </cad-checklist>
    </div>
  </DemoFrame>
  <CodeBlock code={usage} language="html" />

  <ApiReference tagName="cad-checklist" />
  <ApiReference tagName="cad-checklist-item" />

  <style>
    .guidance-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      gap: 1rem;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/checklist'
</script>
