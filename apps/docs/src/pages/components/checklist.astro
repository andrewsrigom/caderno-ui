---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import ExampleCard from '../../components/ExampleCard.astro'
import ExampleGallery from '../../components/ExampleGallery.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-checklist title="Before publishing" variant="mixed">
  <cad-checklist-item>Notes reviewed</cad-checklist-item>
  <cad-checklist-item>Source links checked</cad-checklist-item>
  <cad-checklist-item kind="cross">Summary still missing</cad-checklist-item>
</cad-checklist>

<script type="module">
  import '@caderno-ui/elements/checklist'
</script>`

const variantsUsage = `<cad-checklist title="Do" tone="blue" variant="do">
  <cad-checklist-item>Include source links</cad-checklist-item>
  <cad-checklist-item>Use short headings</cad-checklist-item>
</cad-checklist>

<cad-checklist title="Don't" tone="blue" variant="dont">
  <cad-checklist-item>Copy notes without attribution</cad-checklist-item>
  <cad-checklist-item>Leave broken links</cad-checklist-item>
</cad-checklist>`
---

<DocsLayout
  description="Show a list of recommendations or review results. Use Checkbox for items the user can toggle."
  title="Checklist"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-checklist&gt; family</p>
    <h1>Checklist</h1>
    <p>
      Show a list of recommendations or review results. Use Checkbox for items
      the user can toggle.
    </p>
  </header>

  <DemoFrame title="Review notes">
    <cad-checklist title="Before publishing" variant="mixed">
      <cad-checklist-item>Notes reviewed</cad-checklist-item>
      <cad-checklist-item>Source links checked</cad-checklist-item>
      <cad-checklist-item kind="cross">
        Summary still missing
      </cad-checklist-item>
    </cad-checklist>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ExampleGallery
    id="checklist-variants-title"
    title="Do and don’t"
    description="Use mixed for results, do for recommendations, and don’t for things to avoid."
  >
    <ExampleCard title="Do">
      <cad-checklist
        class="gallery-checklist"
        title="Do"
        tone="blue"
        variant="do"
      >
        <cad-checklist-item>Include source links</cad-checklist-item>
        <cad-checklist-item>Use short headings</cad-checklist-item>
      </cad-checklist>
    </ExampleCard>
    <ExampleCard title="Don't">
      <cad-checklist
        class="gallery-checklist"
        title="Don't"
        tone="blue"
        variant="dont"
      >
        <cad-checklist-item>Copy notes without attribution</cad-checklist-item>
        <cad-checklist-item> Leave broken links </cad-checklist-item>
      </cad-checklist>
    </ExampleCard>
  </ExampleGallery>
  <CodeBlock code={variantsUsage} collapsible language="html" />

  <ApiReference tagName="cad-checklist" />
  <ApiReference tagName="cad-checklist-item" />

  <style>
    .gallery-checklist {
      width: 100%;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/checklist'
</script>
