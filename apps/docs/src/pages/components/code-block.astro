---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const sample = `import '@caderno-ui/elements/card'
import '@caderno-ui/elements/badge'

const card = document.querySelector('cad-card')
card?.addEventListener('click', () => openReview())`

const usage = `<cad-code-block
  code="import '@caderno-ui/elements/card'"
  filename="review-queue.ts"
  language="ts"
  show-line-numbers
>
  <button slot="actions" type="button">Copy</button>
</cad-code-block>

<script type="module">
  import '@caderno-ui/elements/code-block'

  const block = document.querySelector('cad-code-block')
  block?.querySelector('button')?.addEventListener('click', () => {
    navigator.clipboard.writeText(block.code)
  })
</script>`
---

<DocsLayout
  description="Readable preformatted code with optional filename, language, and line numbers."
  title="Code block"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-code-block&gt;</p>
    <h1>Code examples that remain native preformatted text.</h1>
    <p>
      Code block owns presentation, metadata, line numbers, and lightweight
      syntax formatting. Actions remain explicit composition so an application
      can add copy, open, or playground behavior without a forced controller.
    </p>
  </header>

  <DemoFrame
    title="Selective component imports"
    description="A real application entrypoint imports only the card and badge used by its review queue."
  >
    <cad-code-block
      code={sample}
      filename="review-queue.ts"
      language="ts"
      show-line-numbers
      tone="accent"
    >
      <button data-copy-code slot="actions" type="button">Copy</button>
    </cad-code-block>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ApiReference tagName="cad-code-block" />

  <section class="content-section" aria-labelledby="code-boundary">
    <h2 id="code-boundary">Useful formatting, deliberate weight</h2>
    <p>
      HTML and Astro, JavaScript and TypeScript, CSS, JSON, and shell examples
      receive dependency-free token colors. Unknown languages remain readable
      plain text. Teams that need grammar-perfect highlighting can place
      pre-highlighted markup in the default slot instead of shipping a parser to
      every consumer.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/code-block'
</script>
