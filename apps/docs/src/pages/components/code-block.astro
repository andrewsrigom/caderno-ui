---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const sample = `import '@caderno-ui/elements/card'
import '@caderno-ui/elements/badge'

const card = document.querySelector('cad-card')
card?.addEventListener('click', () => openReview())`

const usage = `<cad-code-block
  code="${sample.replaceAll('&', '&amp;').replaceAll('"', '&quot;')}"
  filename="review-queue.ts"
  language="ts"
  show-line-numbers
  copyable
>
</cad-code-block>

<script type="module">
  import '@caderno-ui/elements/code-block'
</script>`
---

<DocsLayout
  description="Display code with syntax colors, optional line numbers, and a copy button."
  title="Code block"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-code-block&gt;</p>
    <h1>Code block</h1>
    <p>
      Display code with syntax colors, optional line numbers, and a copy button.
    </p>
  </header>

  <DemoFrame title="Selective component imports">
    <cad-code-block
      code={sample}
      filename="review-queue.ts"
      language="ts"
      show-line-numbers
      tone="accent"
      copyable
    >
    </cad-code-block>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ApiReference tagName="cad-code-block" />

  <section class="content-section" aria-labelledby="copy-title">
    <h2 id="copy-title">Copying</h2>
    <p>
      Add <code>copyable</code> for the built-in copy button. <code
        >cad-code-copy</code
      > reports success or failure. Use the <code>actions</code> slot for custom controls.
    </p>
  </section>

  <section class="content-section" aria-labelledby="code-boundary">
    <h2 id="code-boundary">Syntax colors</h2>
    <p>
      HTML, Astro, JavaScript, TypeScript, CSS, JSON, and shell have built-in
      syntax colors. Other languages display as plain text. For a different
      highlighter, place pre-highlighted markup in the default slot.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/code-block'
</script>
