---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<p>Keep the <cad-highlight tone="mint">contract explicit</cad-highlight>.</p>
<script type="module">import '@caderno-ui/elements/highlight'</script>`
---

<DocsLayout description="Semantic inline marker treatments." title="Highlight">
  <header class="page-header">
    <p class="eyebrow">&lt;cad-highlight&gt;</p><h1>
      Mark the phrase that carries the decision.
    </h1><p>
      Highlight renders a native mark and offers marker, underline, and
      double-stroke treatments without changing the text color contract.
    </p>
  </header>
  <DemoFrame title="Marker treatments"
    ><p class="sample">
      Review the <cad-highlight>public contract</cad-highlight>, preserve <cad-highlight
        tone="mint"
        variant="underline">native semantics</cad-highlight
      >, and test <cad-highlight tone="violet" variant="double"
        >every boundary</cad-highlight
      >.
    </p></DemoFrame
  >
  <CodeBlock code={usage} collapsible language="html" />
  <ApiReference tagName="cad-highlight" />
  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2><p>
      Use highlight for relevance, not as the only status cue. Text remains
      available before the element upgrades.
    </p>
  </section>
  <style>
    .sample {
      font: 1.2rem/1.8 var(--cad-font-book);
    }
  </style>
</DocsLayout>
