    href: '/components/tabs/',
    icon: 'layers',
    label: 'Tabs',
    tag: '<cad-tabs>',
  },
  {
    description: 'Rows and columns in a handwritten style.',
    href: '/components/table/',
    icon: 'grid',
    label: 'Table',
    tag: '<cad-table>',
  },
  {
    description: 'Links to page sections, for Astro.',
    href: '/components/table-of-contents/',
    icon: 'checklist',
    label: 'Table of contents',
    tag: 'TableOfContents.astro',
  },
  {
    description: 'Multi-line text fields.',
    href: '/components/textarea/',
    icon: 'note',
    label: 'Textarea',
    tag: '<cad-textarea>',
  },
  {
    description: 'Temporary notifications, with an optional action.',
    href: '/components/toast/',
    icon: 'spark',
    label: 'Toast',
    tag: '<cad-toast>',
  },
  {
    description: 'Short hints on hover or focus.',
    href: '/components/tooltip/',
    icon: 'question',
    label: 'Tooltip',
    tag: '<cad-tooltip>',
  },
] as const
---

<DocsLayout
  description="Explore the accessible, framework-agnostic components available in Caderno UI."
  title="Components"
>
  <header class="page-header">
    <h1>Components</h1>
    <p>Browse examples, variations, and the API for each component.</p>
  </header>

  <div class="component-grid">
    {
      components.map((component) => (
        <Card variant="outlined" href={`${base}${component.href}`}>
          <CardContent>
            <cad-icon name={component.icon} size="28" />
            <CardTitle>{component.label}</CardTitle>
            <code>{component.tag}</code>
            <p>{component.description}</p>
          </CardContent>
        </Card>
      ))
    }
  </div>

  <DemoFrame title="Combined example">
    <div class="component-stack">
      <cad-alert heading="Study plan" variant="info">
        Save the plan and switch between Build and Review.
      </cad-alert>
      <cad-bookmark bookmark-id="component-index-demo" label="Save this plan"
      ></cad-bookmark>
      <cad-tabs default-value="build">
        <cad-tabs-list label="Study plan stages">
          <cad-tab-trigger active label="Build" value="build">
            Build
          </cad-tab-trigger>
          <cad-tab-trigger label="Review" value="review">
            Review
          </cad-tab-trigger>
        </cad-tabs-list>
        <cad-tab-content value="build">
          Build the first working version.
        </cad-tab-content>
        <cad-tab-content value="review">
          Check the result with a keyboard and screen reader.
        </cad-tab-content>
      </cad-tabs>
    </div>
  </DemoFrame>
  <CodeBlock code={compositionUsage} language="html" collapsible />
</DocsLayout>

<style>
  .component-stack {
    display: grid;
    gap: var(--cad-space-4, 1rem);
    width: min(100%, 48rem);
  }
</style>

<script>
  import '@caderno-ui/elements/alert'
  import '@caderno-ui/elements/bookmark'
  import '@caderno-ui/elements/icon'
  import '@caderno-ui/elements/tabs'
</script>
