    icon: 'spark',
    label: 'Icon',
    tag: '<cad-icon>',
  },
  {
    description:
      'Form-associated text input with native validation and reset behavior.',
    href: '/components/input/',
    icon: 'pencil',
    label: 'Input',
    tag: '<cad-input>',
  },
  {
    description:
      'Composable planning boards with independent columns and cards.',
    href: '/components/kanban/',
    icon: 'grid',
    label: 'Kanban',
    tag: '<cad-kanban>',
  },
  {
    description: 'Native anchors with marker, underline, and plain treatments.',
    href: '/components/link/',
    icon: 'arrow-right',
    label: 'Link',
    tag: '<cad-link>',
  },
  {
    description:
      'Native modal dialog with focus restoration and composed events.',
    href: '/components/modal/',
    icon: 'layers',
    label: 'Modal',
    tag: '<cad-modal>',
  },
  {
    description: 'Semantic supporting content on notebook-styled paper.',
    href: '/components/note/',
    icon: 'note',
    label: 'Note',
    tag: '<cad-note>',
  },
  {
    description:
      'Neutral ruled, grid, dotted, or blank surfaces for native content.',
    href: '/components/paper/',
    icon: 'note',
    label: 'Paper',
    tag: '<cad-paper>',
  },
  {
    description: 'URL-based collection navigation with compact truncation.',
    href: '/components/pagination/',
    icon: 'arrow-right',
    label: 'Pagination',
    tag: '<cad-pagination>',
  },
