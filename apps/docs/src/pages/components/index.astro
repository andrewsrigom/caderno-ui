    href: '/components/radio/',
    icon: 'target',
    label: 'Radio',
    tag: '<cad-radio>',
  },
  {
    description: 'Placeholders while content loads.',
    href: '/components/skeleton/',
    icon: 'layers',
    label: 'Skeleton',
    tag: '<cad-skeleton>',
  },
  {
    description: 'Select a number or range.',
    href: '/components/slider/',
    icon: 'gauge',
    label: 'Slider',
    tag: '<cad-slider>',
  },
  {
    description: 'An indicator for ongoing work.',
    href: '/components/spinner/',
    icon: 'reset',
