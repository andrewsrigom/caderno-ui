    href: '/components/checkbox/',
    icon: 'check',
    label: 'Checkbox',
    tag: '<cad-checkbox>',
  },
  {
    description: 'Recommendations and review results.',
    href: '/components/checklist/',
    icon: 'checklist',
    label: 'Checklist',
    tag: '<cad-checklist>',
  },
  {
    description: 'Code with syntax colors and optional copying.',
    href: '/components/code-block/',
    icon: 'brackets',
    label: 'Code block',
    tag: '<cad-code-block>',
  },
  {
    description: 'Lines between sections.',
    href: '/components/divider/',
    icon: 'underline',
    label: 'Divider',
    tag: '<cad-divider>',
  },
  {
