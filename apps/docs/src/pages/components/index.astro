---
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const compositionUsage = `<cad-paper margin pattern="ruled" spacing="spacious">
  <cad-alert heading="Study plan" variant="info">
    Save the note, then move between the implementation and review panels.
  </cad-alert>
  <cad-tabs default-value="build">
    <!-- Compose the tab family around application-owned content. -->
  </cad-tabs>
</cad-paper>`
const components = [
  {
    description:
      'Native details disclosures with optional single-open coordination.',
    href: '/components/accordion/',
    icon: 'layers',
    label: 'Accordion',
    tag: '<cad-accordion>',
  },
  {
    description: 'Semantic status messages with four variants and dismissal.',
    href: '/components/alert/',
    icon: 'exclamation',
    label: 'Alert',
    tag: '<cad-alert>',
  },
  {
    description:
      'Compact identity with initials, portrait, and presence status.',
    href: '/components/avatar/',
    icon: 'brain',
    label: 'Avatar',
    tag: '<cad-avatar>',
  },
  {
    description:
      'Compact status and metadata labels without false interaction.',
    href: '/components/badge/',
    icon: 'box',
    label: 'Badge',
    tag: '<cad-badge>',
  },
  {
    description:
      'Semantic quotations and decision excerpts with optional attribution.',
    href: '/components/blockquote/',
    icon: 'note',
    label: 'Blockquote',
    tag: '<cad-blockquote>',
  },
  {
    description:
      'A pressed-state save control with optional local persistence.',
    href: '/components/bookmark/',
    icon: 'bookmark',
    label: 'Bookmark',
    tag: '<cad-bookmark>',
  },
  {
    description: 'Composable native links for hierarchical location trails.',
    href: '/components/breadcrumb/',
    icon: 'arrow-right',
    label: 'Breadcrumb',
    tag: '<cad-breadcrumb>',
  },
  {
    description: 'Native actions and links with form-aware notebook styling.',
    href: '/components/button/',
    icon: 'check',
    label: 'Button',
    tag: '<cad-button>',
  },
  {
    description: 'Static editorial guidance without live-region announcements.',
    href: '/components/callout/',
    icon: 'lightbulb',
    label: 'Callout',
    tag: '<cad-callout>',
  },
  {
    description: 'Composable paper surfaces with optional link semantics.',
    href: '/components/card/',
    icon: 'note',
    label: 'Card',
    tag: '<cad-card>',
  },
  {
    description: 'Accessible hand-drawn bar, line, and donut visualizations.',
    href: '/components/chart/',
    icon: 'gauge',
    label: 'Chart',
    tag: '<cad-chart>',
  },
  {
    description: 'Form-associated checklist state with native validation.',
    href: '/components/checkbox/',
    icon: 'check',
    label: 'Checkbox',
    tag: '<cad-checkbox>',
  },
  {
    description: 'Composable checklists and do/don’t review guidance.',
    href: '/components/checklist/',
    icon: 'checklist',
    label: 'Checklist',
    tag: '<cad-checklist>',
  },
  {
    description:
      'Native preformatted code with optional filename and line numbers.',
    href: '/components/code-block/',
    icon: 'brackets',
    label: 'Code block',
    tag: '<cad-code-block>',
  },
  {
    description: 'Decorative or semantic dashed, dotted, and wavy separators.',
    href: '/components/divider/',
    icon: 'underline',
    label: 'Divider',
    tag: '<cad-divider>',
  },
