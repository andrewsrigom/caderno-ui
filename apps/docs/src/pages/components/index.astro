    description: 'Determinate and indeterminate native progress semantics.',
    href: '/components/progress/',
    icon: 'checklist',
    label: 'Progress',
    tag: '<cad-progress>',
  },
  {
    description:
      'Cross-shadow radio grouping with native forms and arrow keys.',
    href: '/components/radio/',
    icon: 'target',
    label: 'Radio',
    tag: '<cad-radio>',
  },
  {
    description: 'Named indeterminate work with reduced-motion support.',
    href: '/components/spinner/',
    icon: 'reset',
    label: 'Spinner',
    tag: '<cad-spinner>',
  },
  {
    description:
      'Responsive numbered sequences for methods, timelines, and rollouts.',
    href: '/components/steps/',
    icon: 'checklist',
    label: 'Steps',
    tag: '<cad-steps>',
  },
  {
    description:
      'Decorative labels for categories, milestones, and annotations.',
    href: '/components/sticker/',
    icon: 'spark',
    label: 'Sticker',
    tag: '<cad-sticker>',
  },
  {
    description: 'Keyboard-accessible tabs with declarative panel children.',
    href: '/components/tabs/',
    icon: 'layers',
    label: 'Tabs',
    tag: '<cad-tabs>',
  },
  {
    description:
      'Responsive native tables with declarative rows and notebook treatments.',
    href: '/components/table/',
    icon: 'grid',
    label: 'Table',
    tag: '<cad-table>',
  },
  {
    description: 'Decorative translucent tape for notebook compositions.',
    href: '/components/tape/',
    icon: 'tape',
    label: 'Tape',
    tag: '<cad-tape>',
  },
  {
    description: 'Form-associated ruled writing surface for longer responses.',
    href: '/components/textarea/',
    icon: 'note',
    label: 'Textarea',
    tag: '<cad-textarea>',
  },
  {
    description:
      'Declarative and hosted notifications with safe plain-text creation.',
    href: '/components/toast/',
    icon: 'spark',
    label: 'Toast',
    tag: '<cad-toast>',
  },
  {
    description: 'Short hover and focus descriptions with Escape dismissal.',
    href: '/components/tooltip/',
    icon: 'question',
    label: 'Tooltip',
    tag: '<cad-tooltip>',
  },
] as const
---

<DocsLayout
  description="Explore the accessible, framework-agnostic components available in Caderno UI."
  title="Components"
>
  <header class="page-header">
    <p class="eyebrow">Component index</p>
    <h1>Small set. Explicit contracts.</h1>
    <p>
      Caderno UI starts with the components that already proved useful in a real
      product. Each page documents attributes, events, slots, parts, and design
      tokens as public API.
    </p>
  </header>

  <div class="component-grid">
    {
      components.map((component) => (
        <a class="component-card" href={`${base}${component.href}`}>
          <cad-icon name={component.icon} size="28" />
          <h2>{component.label}</h2>
          <code>{component.tag}</code>
          <p>{component.description}</p>
        </a>
      ))
    }
  </div>

  <DemoFrame
    title="The components together"
    description="All behavior below comes from the same Lit-based element package."
  >
    <cad-paper margin pattern="ruled" spacing="spacious">
      <cad-alert heading="Study plan" variant="info">
        Save the note, then move between the implementation and review panels.
      </cad-alert>
      <cad-bookmark bookmark-id="component-index-demo" label="Save this plan"
      ></cad-bookmark>
      <cad-tabs default-value="build">
        <cad-tabs-list label="Study plan stages">
          <cad-tab-trigger label="Build" tone="mint" value="build">
            Build
          </cad-tab-trigger>
          <cad-tab-trigger label="Review" tone="lemon" value="review">
            Review
          </cad-tab-trigger>
        </cad-tabs-list>
        <cad-tab-content value="build">
          Implement the smallest complete behavior and keep its contract typed.
        </cad-tab-content>
        <cad-tab-content value="review">
          Verify semantics, keyboard behavior, events, and package boundaries.
        </cad-tab-content>
      </cad-tabs>
    </cad-paper>
  </DemoFrame>
  <CodeBlock code={compositionUsage} language="html" collapsible />
</DocsLayout>
