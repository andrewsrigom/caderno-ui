---
import Card from '@caderno-ui/astro/Card.astro'
import CardContent from '@caderno-ui/astro/CardContent.astro'
import CardTitle from '@caderno-ui/astro/CardTitle.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const compositionUsage = `<cad-alert heading="Study plan" variant="info">
  Save the plan and switch between Build and Review.
</cad-alert>
<cad-bookmark bookmark-id="component-index-demo" label="Save this plan"
></cad-bookmark>
<cad-tabs default-value="build">
  <cad-tabs-list label="Study plan stages">
    <cad-tab-trigger active label="Build" value="build">
      Build
    </cad-tab-trigger>
    <cad-tab-trigger label="Review" value="review">
      Review
    </cad-tab-trigger>
  </cad-tabs-list>
  <cad-tab-content value="build">
    Build the first working version.
  </cad-tab-content>
  <cad-tab-content value="review">
    Check the result with a keyboard and screen reader.
  </cad-tab-content>
</cad-tabs>

<script type="module">
  import '@caderno-ui/elements/alert'
  import '@caderno-ui/elements/bookmark'
  import '@caderno-ui/elements/tabs'
</script>`

const components = [
  {
    description: 'Collapsible sections.',
    href: '/components/accordion/',
    icon: 'layers',
    label: 'Accordion',
    tag: '<cad-accordion>',
  },
  {
    description: 'Status messages and actions.',
    href: '/components/alert/',
    icon: 'exclamation',
    label: 'Alert',
    tag: '<cad-alert>',
  },
  {
    description: 'Initials, portraits, and presence.',
    href: '/components/avatar/',
    icon: 'brain',
    label: 'Avatar',
    tag: '<cad-avatar>',
  },
  {
    description: 'Hand-drawn faces.',
    href: '/components/doodle-avatar/',
    icon: 'scribble',
    label: 'Doodle avatar',
    tag: '<cad-doodle-avatar>',
  },
  {
    description: 'Short status and category labels.',
    href: '/components/badge/',
    icon: 'box',
    label: 'Badge',
    tag: '<cad-badge>',
  },
  {
    description: 'Quotations with optional sources.',
    href: '/components/blockquote/',
    icon: 'note',
    label: 'Blockquote',
    tag: '<cad-blockquote>',
  },
  {
    description: 'Save or unsave an item.',
    href: '/components/bookmark/',
    icon: 'bookmark',
    label: 'Bookmark',
    tag: '<cad-bookmark>',
  },
  {
    description: 'Links to parent pages.',
    href: '/components/breadcrumb/',
    icon: 'arrow-right',
    label: 'Breadcrumb',
    tag: '<cad-breadcrumb>',
  },
  {
    description: 'Actions, form submission, and navigation.',
    href: '/components/button/',
    icon: 'check',
    label: 'Button',
    tag: '<cad-button>',
  },
  {
    description: 'Tips and warnings within a page.',
    href: '/components/callout/',
    icon: 'lightbulb',
    label: 'Callout',
    tag: '<cad-callout>',
  },
  {
    description: 'Related content in one container.',
    href: '/components/card/',
    icon: 'note',
    label: 'Card',
    tag: '<cad-card>',
  },
  {
    description: 'Bar, line, and donut charts.',
    href: '/components/chart/',
    icon: 'gauge',
    label: 'Chart',
    tag: '<cad-chart>',
  },
  {
