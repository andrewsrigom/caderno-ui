---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<div class="field-board">
  <cad-input label="Default" layout="inline" placeholder="Type something…"></cad-input>
  <cad-input label="Focus" layout="inline" placeholder="Type something…"></cad-input>
  <cad-input label="With icon" layout="inline" placeholder="Search…">
    <cad-icon aria-hidden="true" name="search" size="18" slot="prefix"></cad-icon>
  </cad-input>
  <cad-input invalid label="Error" layout="inline" placeholder="Enter a valid value…"></cad-input>
</div>

<script type="module">
  import '@caderno-ui/elements/input'
  import '@caderno-ui/elements/icon'
</script>`
---

<DocsLayout
  description="Collect a single line of text, with labels, hints, and validation."
  title="Input"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-input&gt;</p>
    <h1>Input</h1>
    <p>Collect a single line of text, with labels, hints, and validation.</p>
  </header>

  <DemoFrame title="Field states">
    <div class="field-board">
      <cad-input label="Default" layout="inline" placeholder="Type something…"
      ></cad-input>
      <cad-input label="Focus" layout="inline" placeholder="Type something…"
      ></cad-input>
      <cad-input label="With icon" layout="inline" placeholder="Search…">
        <cad-icon aria-hidden="true" name="search" size="18" slot="prefix"
        ></cad-icon>
      </cad-input>
      <cad-input
        invalid
        label="Error"
        layout="inline"
        placeholder="Enter a valid value…"></cad-input>
    </div>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />
  <ApiReference tagName="cad-input" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility and forms</h2>
    <p>
      Give every field a visible label. Invalid fields expose <code
        >aria-invalid</code
      >; pair the visual error mark with a helpful error message.
    </p>
  </section>

  <style>
    .field-board {
      display: grid;
      gap: 0.9rem;
      max-width: 42rem;
      padding-inline-end: 1.25rem;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/icon'
  import '@caderno-ui/elements/input'
</script>
