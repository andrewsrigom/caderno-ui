---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-kanban label="Release readiness">
  <cad-kanban-column title="Planned">
    <cad-kanban-card tone="coral">Replace temporary package links</cad-kanban-card>
  </cad-kanban-column>
  <cad-kanban-column title="In review">
    <cad-kanban-card tone="blue">Validate selective bundles</cad-kanban-card>
    <cad-kanban-card tone="lemon">Review keyboard navigation</cad-kanban-card>
  </cad-kanban-column>
  <cad-kanban-column title="Ready">
    <cad-kanban-card tone="blue">Compound card contract</cad-kanban-card>
    <cad-kanban-card tone="blue">Responsive semantic table</cad-kanban-card>
  </cad-kanban-column>
</cad-kanban>

<script type="module">
  import '@caderno-ui/elements/kanban'
</script>`
---

<DocsLayout
  description="Organize cards into columns. Drag-and-drop, filtering, and saving are handled by your application."
  title="Kanban"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-kanban&gt; family</p>
    <h1>Kanban</h1>
    <p>
      Organize cards into columns. Drag-and-drop, filtering, and saving are
      handled by your application.
    </p>
  </header>

  <DemoFrame
    title="Release readiness"
    description="Column counts follow the cards."
  >
    <cad-kanban label="Release readiness">
      <cad-kanban-column title="Planned">
        <cad-kanban-card tone="coral">
          Replace temporary package links
        </cad-kanban-card>
      </cad-kanban-column>
      <cad-kanban-column title="In review">
        <cad-kanban-card tone="blue">
          Validate selective bundles
        </cad-kanban-card>
        <cad-kanban-card tone="lemon">
          Review keyboard navigation
        </cad-kanban-card>
      </cad-kanban-column>
      <cad-kanban-column title="Ready">
        <cad-kanban-card tone="blue">Compound card contract</cad-kanban-card>
        <cad-kanban-card tone="blue">
          Responsive semantic table
        </cad-kanban-card>
      </cad-kanban-column>
    </cad-kanban>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ApiReference tagName="cad-kanban" />
  <ApiReference tagName="cad-kanban-column" />
  <ApiReference tagName="cad-kanban-card" />

  <section class="content-section" aria-labelledby="kanban-boundary">
    <h2 id="kanban-boundary">Moving cards</h2>
    <p>
      Drag-and-drop is not built in. If you add it, include keyboard movement,
      status announcements, saving, and undo.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/kanban'
</script>
