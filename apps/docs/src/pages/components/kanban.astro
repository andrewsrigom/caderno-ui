---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-kanban label="Weekly reading">
  <cad-kanban-column title="Planned">
    <cad-kanban-card tone="coral">Read the chapter on caching</cad-kanban-card>
  </cad-kanban-column>
  <cad-kanban-column title="In review">
    <cad-kanban-card tone="blue">Summarize search indexing</cad-kanban-card>
    <cad-kanban-card tone="lemon">Compare queue examples</cad-kanban-card>
  </cad-kanban-column>
  <cad-kanban-column title="Ready">
    <cad-kanban-card tone="blue">Database notes</cad-kanban-card>
    <cad-kanban-card tone="blue">Interview questions</cad-kanban-card>
  </cad-kanban-column>
</cad-kanban>

<script type="module">
  import '@caderno-ui/elements/kanban'
</script>`
---

<DocsLayout
  description="Organize cards into columns. Drag-and-drop, filtering, and saving are handled by your application."
  title="Kanban"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-kanban&gt; family</p>
    <h1>Kanban</h1>
    <p>
      Organize cards into columns. Drag-and-drop, filtering, and saving are
      handled by your application.
    </p>
  </header>

  <DemoFrame
    title="Weekly reading"
    description="Column counts follow the cards."
  >
    <cad-kanban label="Weekly reading">
      <cad-kanban-column title="Planned">
        <cad-kanban-card tone="coral">
          Read the chapter on caching
        </cad-kanban-card>
      </cad-kanban-column>
      <cad-kanban-column title="In review">
        <cad-kanban-card tone="blue">
          Summarize search indexing
        </cad-kanban-card>
        <cad-kanban-card tone="lemon"> Compare queue examples </cad-kanban-card>
      </cad-kanban-column>
      <cad-kanban-column title="Ready">
        <cad-kanban-card tone="blue">Database notes</cad-kanban-card>
        <cad-kanban-card tone="blue"> Interview questions </cad-kanban-card>
      </cad-kanban-column>
    </cad-kanban>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ApiReference tagName="cad-kanban" />
  <ApiReference tagName="cad-kanban-column" />
  <ApiReference tagName="cad-kanban-card" />

  <section class="content-section" aria-labelledby="kanban-boundary">
    <h2 id="kanban-boundary">Moving cards</h2>
    <p>
      Drag-and-drop is not built in. If you add it, include keyboard movement,
      status announcements, saving, and undo.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/kanban'
</script>
