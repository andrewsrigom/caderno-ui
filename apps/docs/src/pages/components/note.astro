---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-note heading="Keep it simple.">
  Write what matters.<br />
  Leave room to think.
</cad-note>

<script type="module">
  import '@caderno-ui/elements/note'
</script>`
---

<DocsLayout
  description="Add a handwritten annotation or reminder. Use Alert for status messages."
  title="Note"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-note&gt;</p>
    <h1>Note</h1>
    <p>
      Add a handwritten annotation or reminder. Use Alert for status messages.
    </p>
  </header>

  <DemoFrame title="A note in the margin">
    <cad-note heading="Keep it simple.">
      Write what matters.<br />
      Leave room to think.
    </cad-note>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ApiReference tagName="cad-note" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      Uses <code>role="note"</code>. Give it a short heading and explain the
      meaning in text, not just color.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/note'
</script>
