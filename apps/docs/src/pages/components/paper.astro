---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-paper elevation="raised" margin pattern="ruled" spacing="spacious">
  <article>
    <h2>Weekly review</h2>
    <p>Keep the document structure owned by your application.</p>
    <ul>
      <li>Review component contracts</li>
      <li>Test selective entrypoints</li>
    </ul>
  </article>
</cad-paper>

<script type="module">
  import '@caderno-ui/elements/paper'
</script>`
---

<DocsLayout
  description="Compose native document structure on ruled, grid, dotted, or blank notebook surfaces."
  title="Paper"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-paper&gt;</p>
    <h1>A notebook surface that does not own your content.</h1>
    <p>
      Paper supplies visual structure—rules, dots, a grid, or a margin—while
      your application keeps control of headings, articles, lists, forms, and
      interaction.
    </p>
  </header>

  <DemoFrame
    title="Three kinds of working paper"
    description="The same neutral primitive supports review notes, system sketches, and research fragments."
  >
    <div class="paper-gallery">
      <cad-paper elevation="raised" margin pattern="ruled" spacing="spacious">
        <article class="paper-example">
          <p class="paper-date">Friday · release review</p>
          <h3>Weekly review</h3>
          <p>
            The public contract is small enough to understand and flexible
            enough to compose.
          </p>
          <ul>
            <li>Browser behavior verified</li>
            <li>Selective imports measured</li>
            <li>Consumer upgrade pending</li>
          </ul>
        </article>
      </cad-paper>

      <cad-paper pattern="grid" tone="blue">
        <article class="paper-example architecture-note">
          <p class="paper-date">System map</p>
          <h3>Source-owned primitives</h3>
          <p><code>tokens → elements → adapters → products</code></p>
          <p>
            Product copy and layout stay at the edge. Components describe a
            reusable capability.
          </p>
        </article>
      </cad-paper>

      <cad-paper pattern="dotted" tone="mint">
        <article class="paper-example">
          <p class="paper-date">Research fragments</p>
          <h3>Questions worth keeping</h3>
          <ol>
            <li>Can the semantics remain native?</li>
            <li>Does the slot remove a product assumption?</li>
            <li>Is the entrypoint independently useful?</li>
          </ol>
        </article>
      </cad-paper>
    </div>
  </DemoFrame>
  <CodeBlock code={usage} language="html" collapsible />

  <section class="content-section" aria-labelledby="choose-pattern-title">
    <h2 id="choose-pattern-title">Choose a pattern for the task</h2>
    <ul>
      <li><strong>ruled</strong> for reading, journaling, and long notes;</li>
      <li>
        <strong>grid</strong> for diagrams, matrices, and spatial planning;
      </li>
      <li><strong>dotted</strong> for flexible sketches and fragments;</li>
      <li><strong>blank</strong> when content should be visually quiet.</li>
    </ul>
    <p>
      Use <code>Note</code> when the content is supporting information with a note
      role. Use <code>Card</code> for an interface region with header, content, and
      footer composition.
    </p>
  </section>

  <ApiReference tagName="cad-paper" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      The element is intentionally semantically neutral. Pattern, margin, and
      elevation are decorative; place native landmarks and correctly ordered
      headings in the default slot. The paper surface does not change keyboard
      behavior or announce itself.
    </p>
  </section>
</DocsLayout>

<style>
  .paper-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  .paper-gallery cad-paper {
    min-height: 19rem;
  }

  .paper-example {
    font-family: var(--cad-font-book);
  }

  .paper-example h3 {
    margin: 0 0 0.75rem;
    font-family: var(--cad-font-hand);
    font-size: 1.55rem;
    line-height: 1.15;
  }

  .paper-example p,
  .paper-example ul,
  .paper-example ol {
    margin-block: 0.65rem;
  }

  .paper-date {
    font-family: var(--cad-font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .architecture-note code {
    font-size: 0.84rem;
    overflow-wrap: anywhere;
  }
</style>
