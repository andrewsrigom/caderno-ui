---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-progress
  label="Reading plan"
  max="8"
  tone="mint"
  value="5"
  show-value
>
  <span slot="fallback">Reading plan: 63%</span>
</cad-progress>

<cad-progress
  current="3"
  label="Interview stages"
  steps="5"
  variant="steps"
></cad-progress>

<script type="module">
  import '@caderno-ui/elements/progress'
</script>`
---

<DocsLayout
  description="CadProgress preserves native progress semantics across bar, steps, and ring visualizations."
  title="Progress"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-progress&gt;</p>
    <h1>Show how far the page has turned.</h1>
    <p>
      Progress uses a native element for every variant, supports determinate and
      indeterminate work, and keeps visible and accessible values aligned.
    </p>
  </header>

  <DemoFrame title="Determinate and indeterminate work">
    <div class="progress-stack">
      <cad-progress
        label="Reading plan"
        max="8"
        tone="mint"
        value="5"
        show-value
      >
        <span slot="fallback">Reading plan: 63%</span>
      </cad-progress>
      <cad-progress label="Indexing notes" tone="blue" show-value>
        <span slot="fallback">Indexing notes: in progress</span>
      </cad-progress>
      <cad-progress
        label="Review confidence"
        max="10"
        tone="lemon"
        value="8"
        value-label="Ready"
        show-value
      >
        <span slot="fallback">Review confidence: ready</span>
      </cad-progress>
      <cad-progress
        current="3"
        label="Interview stages"
        steps="5"
        tone="violet"
        variant="steps"
      >
        <span slot="fallback">Interview stages: 60%</span>
      </cad-progress>
      <cad-progress
        label="Review confidence"
        max="10"
        tone="pink"
        value="8"
        variant="ring"
      >
        <span slot="fallback">Review confidence: 80%</span>
      </cad-progress>
    </div>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ApiReference tagName="cad-progress" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      A native <code>progress</code> element remains in the accessibility tree for
      bar, steps, and ring variants. Omit <code>value</code> while duration is unknown
      and use <code>value-label</code> when words communicate the state better.
    </p>
  </section>

  <style>
    .progress-stack {
      display: grid;
      gap: 1.25rem;
    }
  </style>
</DocsLayout>
