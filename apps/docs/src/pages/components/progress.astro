---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import ExampleCard from '../../components/ExampleCard.astro'
import ExampleGallery from '../../components/ExampleGallery.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-progress
  label="Uploading file"
  max="100"
  show-value
  tone="blue"
  value="72"
>
  <span slot="fallback">Uploading file: 72%</span>
</cad-progress>

<script type="module">
  import '@caderno-ui/elements/progress'
</script>`

const variantsUsage = `<cad-progress label="Data synced" show-value tone="mint" value="100"></cad-progress>
<cad-progress label="Storage almost full" show-value tone="amber" value="85"></cad-progress>
<cad-progress label="Import failed" show-value tone="red" value="40"></cad-progress>
<cad-progress label="Connecting to server"></cad-progress>
<cad-progress label="Processing items" max="50" size="sm" value="34" value-label="34 of 50"></cad-progress>`
---

<DocsLayout
  description="Show how much of a task is complete, or indicate that work is still running."
  title="Progress"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-progress&gt;</p>
    <h1>Progress</h1>
    <p>
      Show how much of a task is complete, or indicate that work is still
      running.
    </p>
  </header>

  <DemoFrame title="Uploading file">
    <cad-progress
      label="Uploading file"
      max="100"
      show-value
      tone="blue"
      value="72"
    >
      <span slot="fallback">Uploading file: 72%</span>
    </cad-progress>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ExampleGallery
    id="progress-variants-title"
    title="States and sizes"
    description="Omit value when progress is unknown."
  >
    <ExampleCard title="Success">
      <cad-progress
        class="gallery-progress"
        label="Data synced"
        show-value
        tone="mint"
        value="100"></cad-progress>
    </ExampleCard>
    <ExampleCard title="Warning">
      <cad-progress
        class="gallery-progress"
        label="Storage almost full"
        show-value
        tone="amber"
        value="85"></cad-progress>
    </ExampleCard>
    <ExampleCard title="Error">
      <cad-progress
        class="gallery-progress"
        label="Import failed"
        show-value
        tone="red"
        value="40"></cad-progress>
    </ExampleCard>
    <ExampleCard title="Indeterminate">
      <cad-progress class="gallery-progress" label="Connecting to server"
      ></cad-progress>
    </ExampleCard>
    <ExampleCard title="Small · count" wide>
      <cad-progress
        class="gallery-progress"
        label="Processing items"
        max="50"
        size="sm"
        value="34"
        value-label="34 of 50"></cad-progress>
    </ExampleCard>
  </ExampleGallery>
  <CodeBlock code={variantsUsage} collapsible language="html" />

  <section class="content-section" aria-labelledby="sizes-tones-title">
    <h2 id="sizes-tones-title">Sizes and values</h2>
    <p>
      Sizes are default, <code>sm</code>, and <code>xs</code>. Blue is standard
      progress; mint, amber, and red indicate success, warning, and error.
      Neutral is also available.
    </p>
    <p>
      Omit <code>value</code> when progress is unknown. Use <code
        >value-label</code
      > for counts such as “34 of 50”; the same text is visible and accessible.
    </p>
  </section>

  <ApiReference tagName="cad-progress" />

  <style>
    .gallery-progress {
      width: 100%;
    }
  </style>

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      Uses native <code>&lt;progress&gt;</code>. Set <code>value</code> and <code
        >max</code
      > for measured progress. Omit <code>value</code> for ongoing work without a
      known percentage.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/progress'
</script>
