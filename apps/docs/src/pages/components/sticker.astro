---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-sticker icon="spark" shape="burst" tone="lemon">New</cad-sticker>
<script type="module">import '@caderno-ui/elements/sticker'</script>`
---

<DocsLayout
  description="Decorative notebook labels and milestones."
  title="Sticker"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-sticker&gt;</p><h1>
      Label the margin with personality.
    </h1><p>
      Sticker combines concise text with optional decorative icons and five
      reusable notebook shapes.
    </p>
  </header>
  <DemoFrame title="Shapes and tones"
    ><div class="demo-row">
      <cad-sticker icon="check" tone="mint">Reviewed</cad-sticker><cad-sticker
        shape="banner"
        tone="blue">Architecture</cad-sticker
      ><cad-sticker icon="spark" shape="burst" tone="lemon">New</cad-sticker
      ><cad-sticker shape="bubble" tone="violet">Ask why</cad-sticker>
    </div></DemoFrame
  >
  <CodeBlock code={usage} language="html" />
  <ApiReference tagName="cad-sticker" />
  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2><p>
      Keep the meaning in the text. Icon, color, rotation, and shape are
      decorative supporting cues.
    </p>
  </section>
  <style>
    .demo-row {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      align-items: center;
    }
  </style>
</DocsLayout>
