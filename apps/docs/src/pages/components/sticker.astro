---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-sticker shape="burst" tone="lemon">
  <cad-icon aria-hidden="true" name="spark" slot="start"></cad-icon>
  New
</cad-sticker>
<script type="module">
  import '@caderno-ui/elements/sticker'
  import '@caderno-ui/elements/icon'
</script>`
---

<DocsLayout
  description="Decorative notebook labels and milestones."
  title="Sticker"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-sticker&gt;</p><h1>
      Label the margin with personality.
    </h1><p>
      Sticker combines concise text with five reusable notebook shapes. A
      leading illustration is composed through a slot instead of being coupled
      to the icon registry.
    </p>
  </header>
  <DemoFrame title="Shapes and tones"
    ><div class="demo-row">
      <cad-sticker tone="mint">
        <cad-icon aria-hidden="true" name="check" size="17" slot="start"
        ></cad-icon>Reviewed</cad-sticker
      ><cad-sticker shape="banner" tone="blue">Architecture</cad-sticker
      ><cad-sticker shape="burst" tone="lemon">
        <cad-icon aria-hidden="true" name="spark" size="17" slot="start"
        ></cad-icon>New</cad-sticker
      ><cad-sticker shape="bubble" tone="violet">Ask why</cad-sticker>
    </div></DemoFrame
  >
  <CodeBlock code={usage} language="html" />
  <ApiReference tagName="cad-sticker" />
  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2><p>
      Keep the meaning in the text. Icon, color, rotation, and shape are
      decorative supporting cues.
    </p>
  </section>
  <style>
    .demo-row {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      align-items: center;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/icon'
  import '@caderno-ui/elements/sticker'
</script>
