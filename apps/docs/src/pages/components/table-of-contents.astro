---
import TableOfContents from '@caderno-ui/astro/TableOfContents.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `---
import TableOfContents from '@caderno-ui/astro/TableOfContents.astro'
---
<TableOfContents
  ariaLabel="Neste capítulo"
  items={[
    { id: 'diagnostico', title: 'Diagnóstico antes da solução' },
    { id: 'hipoteses', level: 3, title: 'Organizando hipóteses' },
    { id: 'validacao', title: 'Validação e próximos passos' },
  ]}
  title="Neste capítulo"
/>`
---

<DocsLayout
  description="Link to sections of a long page and highlight the section being read. Available as an Astro component."
  title="Table of contents"
>
  <header class="page-header">
    <p class="eyebrow">TableOfContents.astro</p>
    <h1>Table of contents</h1>
    <p>
      Link to sections of a long page and highlight the section being read.
      Available as an Astro component.
    </p>
  </header>
  <DemoFrame title="Explicit chapter outline">
    <TableOfContents
      ariaLabel="Neste capítulo"
      items={[
        { id: 'diagnostico', title: 'Diagnóstico antes da solução' },
        { id: 'hipoteses', level: 3, title: 'Organizando hipóteses' },
        { id: 'validacao', title: 'Validação e próximos passos' },
      ]}
      title="Neste capítulo"
    />
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="astro" />
  <section class="content-section" aria-labelledby="behavior-title">
    <h2 id="behavior-title">Behavior</h2>
    <p>
      Pass <code>items</code> to show links before JavaScript loads. Automatic discovery
      finds <code>h2</code> and <code>h3</code> headings, creates anchors, and tracks
      the visible section.
    </p>
  </section>
</DocsLayout>
