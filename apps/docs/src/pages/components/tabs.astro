---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-tabs default-value="overview">
  <cad-tabs-list label="Architecture review workspace">
    <cad-tab-trigger active label="Overview" value="overview">
      <cad-icon aria-hidden="true" name="book" size="20" slot="start"></cad-icon>
      Overview
    </cad-tab-trigger>
    <cad-tab-trigger label="Evidence" value="evidence">
      <cad-icon aria-hidden="true" name="gauge" size="20" slot="start"></cad-icon>
      Evidence
    </cad-tab-trigger>
    <cad-tab-trigger label="Notes" value="notes">
      <cad-icon aria-hidden="true" name="note" size="20" slot="start"></cad-icon>
      Notes
    </cad-tab-trigger>
    <cad-tab-trigger label="Rollout" value="rollout">
      <cad-icon aria-hidden="true" name="rocket" size="20" slot="start"></cad-icon>
      Rollout
    </cad-tab-trigger>
  </cad-tabs-list>

  <cad-tab-content value="overview">
    <h2>Use an asynchronous search index</h2>
    <p>Keep the transactional database authoritative and expose index lag as an observable product state.</p>
  </cad-tab-content>
  <cad-tab-content value="evidence">Evidence collected during the architecture review.</cad-tab-content>
  <cad-tab-content value="notes">Notes, assumptions, and unresolved questions.</cad-tab-content>
  <cad-tab-content value="rollout">A reversible rollout plan with observable checkpoints.</cad-tab-content>
</cad-tabs>

<script type="module">
  import '@caderno-ui/elements/tabs'
  import '@caderno-ui/elements/icon'
</script>`
---

<DocsLayout
  description="Switch between related panels without leaving the page."
  title="Tabs"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-tabs&gt; family</p>
    <h1>Tabs</h1>
    <p>Switch between related panels without leaving the page.</p>
  </header>

  <DemoFrame title="Architecture review workspace">
    <cad-tabs default-value="overview">
      <cad-tabs-list label="Architecture review workspace">
        <cad-tab-trigger active label="Overview" value="overview">
          <cad-icon aria-hidden="true" name="book" size="20" slot="start"
          ></cad-icon>
          Overview
        </cad-tab-trigger>
        <cad-tab-trigger label="Evidence" value="evidence">
          <cad-icon aria-hidden="true" name="gauge" size="20" slot="start"
          ></cad-icon>
          Evidence
        </cad-tab-trigger>
        <cad-tab-trigger label="Notes" value="notes">
          <cad-icon aria-hidden="true" name="note" size="20" slot="start"
          ></cad-icon>
          Notes
        </cad-tab-trigger>
        <cad-tab-trigger label="Rollout" value="rollout">
          <cad-icon aria-hidden="true" name="rocket" size="20" slot="start"
          ></cad-icon>
          Rollout
        </cad-tab-trigger>
      </cad-tabs-list>

      <cad-tab-content value="overview">
        <h2>Use an asynchronous search index</h2>
        <p>
          Keep the transactional database authoritative and expose index lag as
          an observable product state.
        </p>
      </cad-tab-content>
      <cad-tab-content value="evidence">
        Evidence collected during the architecture review.
      </cad-tab-content>
      <cad-tab-content value="notes">
        Notes, assumptions, and unresolved questions.
      </cad-tab-content>
      <cad-tab-content value="rollout">
        A reversible rollout plan with observable checkpoints.
      </cad-tab-content>
    </cad-tabs>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ApiReference tagName="cad-tabs" />
  <ApiReference tagName="cad-tabs-list" />
  <ApiReference tagName="cad-tab-trigger" />
  <ApiReference tagName="cad-tab-content" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      Arrow keys, Home, and End move focus between enabled tabs. Each tab is
      linked to its panel.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/icon'
  import '@caderno-ui/elements/tabs'
</script>
