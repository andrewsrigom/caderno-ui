---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-tabs default-value="notes">
  <cad-tabs-list label="Implementation workspace">
    <cad-tab-trigger label="Notes" tone="lemon" value="notes">
      <cad-icon aria-hidden="true" name="note" slot="start"></cad-icon>
      Notes
    </cad-tab-trigger>
    <cad-tab-trigger label="Code" tone="mint" value="code">Code</cad-tab-trigger>
  </cad-tabs-list>

  <cad-tab-content value="notes">Document the invariant first.</cad-tab-content>
  <cad-tab-content value="code">Implement the smallest complete path.</cad-tab-content>
</cad-tabs>

<script type="module">
  import '@caderno-ui/elements/tabs'
  import '@caderno-ui/elements/icon'
</script>`
---

<DocsLayout
  description="Compound keyboard-accessible tabs with composable triggers and panels."
  title="Tabs"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-tabs&gt; family</p>
    <h1>Compose the controls and content as explicit peers.</h1>
    <p>
      Tabs coordinates a list, native trigger buttons, and matching content
      panels by value. Trigger visuals are ordinary slots, so tabs never import
      or prescribe the icon library.
    </p>
  </header>

  <DemoFrame
    title="Architecture review workspace"
    description="Switch between the decision, evidence, and rollout plan with arrow keys, Home, or End."
  >
    <cad-tabs default-value="decision">
      <cad-tabs-list label="Architecture review workspace">
        <cad-tab-trigger label="Decision" tone="lemon" value="decision">
          <cad-icon aria-hidden="true" name="note" size="16" slot="start"
          ></cad-icon>
          Decision
        </cad-tab-trigger>
        <cad-tab-trigger label="Evidence" tone="mint" value="evidence">
          <cad-icon aria-hidden="true" name="gauge" size="16" slot="start"
          ></cad-icon>
          Evidence
        </cad-tab-trigger>
        <cad-tab-trigger label="Rollout" tone="violet" value="rollout">
          Rollout
        </cad-tab-trigger>
      </cad-tabs-list>

      <cad-tab-content value="decision">
        <h2>Use an asynchronous search index</h2>
        <p>
          Keep the transactional database authoritative and expose index lag as
          an observable product state.
        </p>
      </cad-tab-content>
      <cad-tab-content value="evidence">
        <h2>What supports the decision</h2>
        <p>
          Peak query latency fell while write throughput remained inside the
          recovery budget.
        </p>
      </cad-tab-content>
      <cad-tab-content value="rollout">
        <h2>How to ship it safely</h2>
        <p>
          Dual-read a sampled cohort, compare result sets, then expand behind a
          reversible flag.
        </p>
      </cad-tab-content>
    </cad-tabs>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ApiReference tagName="cad-tabs" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      Trigger labels provide both visible and accessible names. The controller
      implements roving focus and skips disabled triggers; content stays a named
      tab panel and fails open when values are missing or duplicated.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/icon'
  import '@caderno-ui/elements/tabs'
</script>
