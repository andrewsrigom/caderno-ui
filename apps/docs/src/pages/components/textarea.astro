---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<div class="field-board">
  <cad-textarea label="Default" layout="inline" placeholder="Write your notes here…" rows="3"></cad-textarea>
  <cad-textarea label="Focus" layout="inline" placeholder="Write your notes here…" rows="3"></cad-textarea>
  <cad-textarea invalid label="Error" layout="inline" placeholder="Write your notes here…" rows="3"></cad-textarea>
</div>

<script type="module">
  import '@caderno-ui/elements/textarea'
</script>`
---

<DocsLayout
  description="Collect longer text with labels, hints, validation, and resizing."
  title="Textarea"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-textarea&gt;</p>
    <h1>Textarea</h1>
    <p>Collect longer text with labels, hints, validation, and resizing.</p>
  </header>

  <DemoFrame title="Writing states">
    <div class="field-board">
      <cad-textarea
        label="Default"
        layout="inline"
        placeholder="Write your notes here…"
        rows="3"></cad-textarea>
      <cad-textarea
        label="Focus"
        layout="inline"
        placeholder="Write your notes here…"
        rows="3"></cad-textarea>
      <cad-textarea
        invalid
        label="Error"
        layout="inline"
        placeholder="Write your notes here…"
        rows="3"></cad-textarea>
    </div>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />
  <ApiReference tagName="cad-textarea" />

  <section class="content-section" aria-labelledby="forms-title">
    <h2 id="forms-title">Form behavior</h2>
    <p>
      Supports <code>FormData</code>, reset, required validation, disabled
      fieldsets, custom validity, and resizing. Pair invalid state with a
      helpful error message.
    </p>
  </section>

  <style>
    .field-board {
      display: grid;
      gap: 0.9rem;
      max-width: 48rem;
      padding-inline-end: 1.25rem;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/textarea'
</script>
