---
import ApiReference from '../../components/ApiReference.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import DemoFrame from '../../components/DemoFrame.astro'
import ExampleCard from '../../components/ExampleCard.astro'
import ExampleGallery from '../../components/ExampleGallery.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'

const usage = `<cad-tooltip position="top" text="Copy a link to this note">
  <cad-button size="sm" variant="secondary">Share note</cad-button>
</cad-tooltip>

<script type="module">
  import '@caderno-ui/elements/button'
  import '@caderno-ui/elements/tooltip'
</script>`

const placementsUsage = `<cad-tooltip open position="top" text="Appears above">
  <cad-button size="sm" variant="secondary">Top</cad-button>
</cad-tooltip>
<cad-tooltip open position="right" text="Appears to the right">
  <cad-button size="sm" variant="secondary">Right</cad-button>
</cad-tooltip>
<cad-tooltip open position="bottom" text="Appears below">
  <cad-button size="sm" variant="secondary">Bottom</cad-button>
</cad-tooltip>
<cad-tooltip open position="left" text="Appears to the left">
  <cad-button size="sm" variant="secondary">Left</cad-button>
</cad-tooltip>`
---

<DocsLayout
  description="Show a short hint on hover or keyboard focus. Use Popover for links or other controls."
  title="Tooltip"
>
  <header class="page-header">
    <p class="eyebrow">&lt;cad-tooltip&gt;</p>
    <h1>Tooltip</h1>
    <p>
      Show a short hint on hover or keyboard focus. Use Popover for links or
      other controls.
    </p>
  </header>

  <DemoFrame title="Focus or hover">
    <cad-tooltip position="top" text="Copy a link to this note">
      <cad-button size="sm" variant="secondary">Share note</cad-button>
    </cad-tooltip>
  </DemoFrame>
  <CodeBlock code={usage} collapsible language="html" />

  <ExampleGallery
    id="tooltip-placements-title"
    title="Placements"
    description="Leave enough room for the hint in each direction."
  >
    <ExampleCard title="Top">
      <cad-tooltip open position="top" text="Appears above">
        <cad-button size="sm" variant="secondary">Top</cad-button>
      </cad-tooltip>
    </ExampleCard>
    <ExampleCard title="Right">
      <cad-tooltip open position="right" text="Appears to the right">
        <cad-button size="sm" variant="secondary">Right</cad-button>
      </cad-tooltip>
    </ExampleCard>
    <ExampleCard title="Bottom">
      <cad-tooltip open position="bottom" text="Appears below">
        <cad-button size="sm" variant="secondary">Bottom</cad-button>
      </cad-tooltip>
    </ExampleCard>
    <ExampleCard title="Left">
      <cad-tooltip open position="left" text="Appears to the left">
        <cad-button size="sm" variant="secondary">Left</cad-button>
      </cad-tooltip>
    </ExampleCard>
  </ExampleGallery>
  <CodeBlock code={placementsUsage} collapsible language="html" />
  <ApiReference tagName="cad-tooltip" />

  <section class="content-section" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>
      Use one focusable trigger. Keep the hint short and non-interactive. For
      links or controls, use Popover.
    </p>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/button'
  import '@caderno-ui/elements/tooltip'
</script>
