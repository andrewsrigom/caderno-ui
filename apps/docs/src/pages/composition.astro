---
import CodeBlock from '../components/CodeBlock.astro'
import DemoFrame from '../components/DemoFrame.astro'
import DocsLayout from '../layouts/DocsLayout.astro'
import '@caderno-ui/elements/prose.css'

const selectiveImport = `import '@caderno-ui/elements/card'

import '@caderno-ui/elements/badge'`

const cardMarkup = `<cad-card tone="blue">
  <cad-card-header>
    <cad-card-kicker>Architecture review</cad-card-kicker>
    <cad-card-title><h2>Review search delivery</h2></cad-card-title>
  </cad-card-header>
  <cad-card-content>
    <p>Compare query speed and recovery time before choosing an index.</p>
  </cad-card-content>
  <cad-card-footer>
    <cad-badge tone="mint">Verified</cad-badge>
  </cad-card-footer>
</cad-card>`

const proseImport = `import '@caderno-ui/elements/prose.css'
import { installCadernoProse } from '@caderno-ui/elements/prose'

installCadernoProse()`
---

<DocsLayout
  description="Combine components, add your own content, and import only what you use."
  title="Composition"
>
  <header class="page-header">
    <h1>Composition</h1>
    <p>
      Combine components and slots to build the interface you need. Your
      application supplies the content and actions.
    </p>
  </header>

  <section class="content-section" aria-labelledby="rules-title">
    <h2 id="rules-title">How to compose</h2>
    <div class="rules-grid">
      <article>
        <h3>Arrange the parts</h3>
        <p>Add, omit, or reorder Card sections and Tabs panels.</p>
      </article>
      <article>
        <h3>Add content with slots</h3>
        <p>
          Place icons, labels, and actions in the slots each component provides.
        </p>
      </article>
      <article>
        <h3>Keep built-in behavior</h3>
        <p>
          Components handle focus, keyboard input, and form validation. Your app
          handles what happens next.
        </p>
      </article>
      <article>
        <h3>Import icons separately</h3>
        <p>
          Built-in controls include their own marks. Import <code>cad-icon</code
          > only when you add an icon.
        </p>
      </article>
    </div>
  </section>

  <DemoFrame
    title="Card with a badge"
    description="Import Card and Badge for this example."
  >
    <cad-card tone="blue">
      <cad-card-header>
        <cad-card-kicker>Architecture review</cad-card-kicker>
        <cad-card-title><h2>Review search delivery</h2></cad-card-title>
      </cad-card-header>
      <cad-card-content>
        <p>Compare query speed and recovery time before choosing an index.</p>
      </cad-card-content>
      <cad-card-footer>
        <cad-badge tone="mint">Verified</cad-badge>
      </cad-card-footer>
    </cad-card>
  </DemoFrame>

  <CodeBlock code={cardMarkup} language="html" collapsible />
  <CodeBlock code={selectiveImport} language="ts" collapsible />

  <section class="content-section" aria-labelledby="prose-title">
    <h2 id="prose-title">Style HTML and Markdown</h2>
    <p>
      Wrap HTML or rendered Markdown in <code>class="cad-prose"</code>. The
      stylesheet covers headings, lists, quotes, code, and tables.
    </p>
    <DemoFrame title="Semantic Markdown output">
      <article class="cad-prose">
        <h2>Investigate before changing code</h2>
        <p>
          Start with an observable hypothesis and <mark
            >preserve the evidence</mark
          >
          before attempting a fix.
        </p>
        <blockquote>
          <p>A small reproducible case is more useful than a large guess.</p>
        </blockquote>
        <pre><code><span class="line">const evidence = reproduce(issue)</span></code></pre>
        <table>
          <thead><tr><th>Signal</th><th>Meaning</th></tr></thead>
          <tbody
            ><tr><td>Repeatable</td><td>The hypothesis can be tested</td></tr
            ></tbody
          >
        </table>
      </article>
    </DemoFrame>
    <CodeBlock code={proseImport} language="ts" collapsible />
  </section>

  <section class="content-section" aria-labelledby="native-navigation-title">
    <h2 id="native-navigation-title">Navigation without JavaScript</h2>
    <p>
      Use <code>navigation.css</code> with HTML links. Mark the current page with
      <code>aria-current="page"</code>.
    </p>
    <CodeBlock
      language="html"
      code={`<nav class="cad-navigation" aria-label="Documentation">
  <section class="cad-navigation-group">
    <h2 class="cad-navigation-title">Overview</h2>
    <a href="/" aria-current="page">Introduction</a>
    <a href="/getting-started/">Getting started</a>
  </section>
</nav>`}
    />
    <CodeBlock
      language="css"
      code={`@import '@caderno-ui/tokens/notebook.css';
@import '@caderno-ui/elements/navigation.css';`}
    />
  </section>

  <section class="content-section" aria-labelledby="delivery-title">
    <h2 id="delivery-title">Keep imports small</h2>
    <p>
      Import components by subpath. Charts load Rough.js only when you import
      <code>@caderno-ui/elements/chart</code>. Bundle sizes are checked in CI.
    </p>
  </section>

  <style>
    .rules-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      gap: 1rem;
    }

    .rules-grid article {
      padding: 1rem 1.1rem;
      background: var(--cad-surface-raised);
      border: 1px dashed var(--cad-line-strong);
      border-radius: 0;
    }

    .rules-grid :is(h3, p) {
      margin-block: 0;
    }

    .rules-grid p {
      margin-top: 0.5rem;
    }

    cad-card {
      max-width: 36rem;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/badge'
  import '@caderno-ui/elements/card'
  import { installCadernoProse } from '@caderno-ui/elements/prose'

  installCadernoProse()
</script>
