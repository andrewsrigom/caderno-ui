---
import { demoNotes } from '../../../lib/demo-data'
import DemoLayout from '../../../layouts/DemoLayout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const toUrl = (href: string) => `${base}${href}`
const tones = ['lemon', 'blue', 'mint', 'violet', 'lemon', 'blue'] as const
---

<DemoLayout
  description="A searchable note wall with persistent bookmarks, a creation drawer, and a real no-results state."
  title="Notes"
>
  <cad-breadcrumb label="Notes workspace path">
    <cad-breadcrumb-item href={toUrl('/demo/')}>Demo</cad-breadcrumb-item>
    <cad-breadcrumb-item current>Notes</cad-breadcrumb-item>
  </cad-breadcrumb>

  <header class="demo-page-heading">
    <p class="demo-eyebrow">Six notes on the wall</p>
    <h1>Loose ideas, still attached to their context.</h1>
    <p>
      Search the note wall, save individual notes locally, and create a new one
      without leaving the page.
    </p>
    <div class="demo-actions">
      <cad-drawer
        heading="Create a note"
        id="new-note-drawer"
        placement="right"
        size="sm"
      >
        <cad-button slot="trigger" type="button">
          <cad-icon aria-hidden="true" name="pencil" size="20" slot="start"
          ></cad-icon>
          New note
        </cad-button>
        <form class="demo-form">
          <cad-input
            label="Title"
            placeholder="A short, useful heading"
            required></cad-input>
          <cad-textarea
            label="Note"
            placeholder="Write the idea in one page-sized thought..."
            required
            rows="8"></cad-textarea>
        </form>
        <cad-button
          data-cancel-new-note
          slot="footer"
          type="button"
          variant="link"
        >
          Cancel
        </cad-button>
        <cad-button data-save-new-note slot="footer" type="button">
          Save note
        </cad-button>
      </cad-drawer>
    </div>
  </header>

  <section class="demo-section" aria-labelledby="note-wall-title">
    <div class="demo-section-heading">
      <div>
        <p class="demo-section-label">Note wall</p>
        <h2 id="note-wall-title">Search before adding another page.</h2>
      </div>
      <output data-note-count aria-live="polite">
        {demoNotes.length} notes visible
      </output>
    </div>

    <div class="demo-toolbar">
      <cad-input
        data-note-search
        label="Search notes"
        placeholder="Search titles, text, or tags"
        type="search"
      >
        <cad-icon aria-hidden="true" name="search" size="20" slot="prefix"
        ></cad-icon>
      </cad-input>
      <cad-button data-clear-note-search type="button" variant="link">
        Clear search
      </cad-button>
    </div>

    <div class="demo-note-grid" data-note-grid>
      {
        demoNotes.map((note, index) => (
          <cad-note
            data-note-card
            data-search={`${note.heading} ${note.body} ${note.tag}`}
            heading={note.heading}
            id={note.id}
            tone={tones[index]}
          >
            <p>{note.body}</p>
            <div class="demo-note-footer" slot="footer">
              <cad-badge tone={tones[index]}>{note.tag}</cad-badge>
              <cad-bookmark
                active-label={`Remove saved note: ${note.heading}`}
                bookmark-id={`demo-note-${note.id}`}
                label={`Save note: ${note.heading}`}
                persist
              />
            </div>
          </cad-note>
        ))
      }
    </div>

    <cad-empty-state
      class="demo-empty-results"
      data-note-empty
      description="Try a broader phrase or clear the current search."
      hidden
      size="compact"
      title="No notes match"
      tone="blue"
      variant="no-results"
    >
      <cad-icon name="search" slot="icon"></cad-icon>
      <cad-button data-clear-note-search slot="primary" variant="link">
        Clear search
      </cad-button>
    </cad-empty-state>
  </section>
</DemoLayout>

<script>
  import '@caderno-ui/elements/drawer'
  import '@caderno-ui/elements/input'
  import { toast } from '@caderno-ui/elements/toast'
  import type { CadDrawer } from '@caderno-ui/elements/drawer'
  import type { CadInput } from '@caderno-ui/elements/input'

  const search = document.querySelector<CadInput>('[data-note-search]')
  const grid = document.querySelector<HTMLElement>('[data-note-grid]')
  const empty = document.querySelector<HTMLElement>('[data-note-empty]')
  const output = document.querySelector<HTMLOutputElement>('[data-note-count]')
  const notes = Array.from(
    document.querySelectorAll<HTMLElement>('[data-note-card]'),
  )
  const drawer = document.querySelector<CadDrawer>('#new-note-drawer')

  const updateNotes = () => {
    const query = search?.value.trim().toLocaleLowerCase() ?? ''
    let visible = 0
    for (const note of notes) {
      const matches = (note.dataset.search ?? '')
        .toLocaleLowerCase()
        .includes(query)
      note.hidden = !matches
      if (matches) visible += 1
    }
    if (grid) grid.hidden = visible === 0
    if (empty) empty.hidden = visible !== 0
    if (output)
      output.value = `${visible} note${visible === 1 ? '' : 's'} visible`
  }

  search?.addEventListener('input', updateNotes)
  for (const clear of document.querySelectorAll('[data-clear-note-search]')) {
    clear.addEventListener('click', () => {
      if (search) search.value = ''
      updateNotes()
      search?.focus()
    })
  }

  document
    .querySelector('[data-cancel-new-note]')
    ?.addEventListener('click', () => drawer?.close('api'))

  document
    .querySelector('[data-save-new-note]')
    ?.addEventListener('click', () => {
      drawer?.close('api')
      toast.accent('Draft note saved.', {
        action: {
          label: 'View notes',
          onClick: () => window.scrollTo({ behavior: 'smooth', top: 0 }),
        },
        description: 'The demo keeps it in this local session.',
        hostId: 'demo-toasts',
      })
    })
</script>

<script>
  import '@caderno-ui/elements/badge'
  import '@caderno-ui/elements/bookmark'
  import '@caderno-ui/elements/breadcrumb'
  import '@caderno-ui/elements/button'
  import '@caderno-ui/elements/empty-state'
  import '@caderno-ui/elements/icon'
  import '@caderno-ui/elements/note'
  import '@caderno-ui/elements/textarea'
</script>
