---
import { demoProjects } from '../../../lib/demo-data'
import DemoLayout from '../../../layouts/DemoLayout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const toUrl = (href: string) => `${base}${href}`
const columns = [
  { statuses: ['Planned'], title: 'Planned' },
  { statuses: ['In review'], title: 'In review' },
  { statuses: ['Ready'], title: 'Ready' },
]
---

<DemoLayout
  description="Search and review a real project board composed with Caderno UI."
  title="Projects"
>
  <cad-breadcrumb label="Project workspace path">
    <cad-breadcrumb-item href={toUrl('/demo/')}>Demo</cad-breadcrumb-item>
    <cad-breadcrumb-item current>Projects</cad-breadcrumb-item>
  </cad-breadcrumb>

  <header class="demo-page-heading">
    <p class="demo-eyebrow">Four active threads</p>
    <h1>Projects that still need a decision.</h1>
    <p>
      Search the board, open the detailed architecture review, and test how a
      planning surface behaves with real product content.
    </p>
  </header>

  <section class="demo-section" aria-labelledby="project-board-title">
    <div class="demo-section-heading">
      <div>
        <p class="demo-section-label">Workspace</p>
        <h2 id="project-board-title">Project board</h2>
      </div>
      <output data-project-count aria-live="polite">
        {demoProjects.length} projects visible
      </output>
    </div>

    <div class="demo-toolbar">
      <cad-input
        data-project-search
        label="Search projects"
        placeholder="Try ‘search’, ‘queue’, or ‘ready’"
        type="search"
      >
        <cad-icon aria-hidden="true" name="search" size="20" slot="prefix"
        ></cad-icon>
      </cad-input>
      <cad-button data-clear-project-search type="button" variant="link">
        Clear search
      </cad-button>
    </div>

    <cad-kanban data-project-board label="Field Notes projects">
      {
        columns.map((column) => (
          <cad-kanban-column title={column.title}>
            {demoProjects
              .filter((project) => column.statuses.includes(project.status))
              .map((project) => (
                <cad-kanban-card
                  data-project-card
                  data-search={`${project.title} ${project.description} ${project.status}`}
                  tone={project.tone}
                >
                  <article class="demo-kanban-card">
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                    <div class="demo-kanban-meta">
                      <cad-badge tone={project.tone}>
                        {project.status}
                      </cad-badge>
                      <cad-link href={toUrl(project.href)}>
                        Open project
                      </cad-link>
                    </div>
                  </article>
                </cad-kanban-card>
              ))}
          </cad-kanban-column>
        ))
      }
    </cad-kanban>

    <cad-empty-state
      class="demo-empty-results"
      data-project-empty
      description="Try another term or clear the current search."
      hidden
      size="compact"
      title="No projects match"
      tone="blue"
      variant="no-results"
    >
      <cad-icon name="search" slot="icon"></cad-icon>
      <cad-button data-clear-project-search slot="primary" variant="link">
        Clear search
      </cad-button>
    </cad-empty-state>
  </section>

  <section class="demo-section" aria-labelledby="portfolio-title">
    <div class="demo-section-heading">
      <div>
        <p class="demo-section-label">Portfolio view</p>
        <h2 id="portfolio-title">The same work as structured data.</h2>
      </div>
    </div>
    <cad-table
      caption="Active project portfolio"
      min-width="38rem"
      variant="ruled"
    >
      <cad-table-column key="project" label="Project"></cad-table-column>
      <cad-table-column key="status" label="Status"></cad-table-column>
      <cad-table-column key="review" label="Next review"></cad-table-column>
      <cad-table-column key="confidence" label="Confidence"></cad-table-column>
      <cad-table-row>
        <cad-table-cell column="project"
          >Search indexing strategy</cad-table-cell
        >
        <cad-table-cell column="status">In review</cad-table-cell>
        <cad-table-cell column="review">Friday</cad-table-cell>
        <cad-table-cell column="confidence">72%</cad-table-cell>
      </cad-table-row>
      <cad-table-row>
        <cad-table-cell column="project">Behavioral story bank</cad-table-cell>
        <cad-table-cell column="status">Ready</cad-table-cell>
        <cad-table-cell column="review">Monday</cad-table-cell>
        <cad-table-cell column="confidence">91%</cad-table-cell>
      </cad-table-row>
      <cad-table-row>
        <cad-table-cell column="project">Queue semantics</cad-table-cell>
        <cad-table-cell column="status">Planned</cad-table-cell>
        <cad-table-cell column="review">Next week</cad-table-cell>
        <cad-table-cell column="confidence">38%</cad-table-cell>
      </cad-table-row>
    </cad-table>
  </section>
</DemoLayout>

<script>
  import '@caderno-ui/elements/input'
  import type { CadInput } from '@caderno-ui/elements/input'

  const search = document.querySelector<CadInput>('[data-project-search]')
  const board = document.querySelector<HTMLElement>('[data-project-board]')
  const empty = document.querySelector<HTMLElement>('[data-project-empty]')
  const output = document.querySelector<HTMLOutputElement>(
    '[data-project-count]',
  )
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-project-card]'),
  )

  const updateProjects = () => {
    const query = search?.value.trim().toLocaleLowerCase() ?? ''
    let visible = 0

    for (const card of cards) {
      const matches = (card.dataset.search ?? '')
        .toLocaleLowerCase()
        .includes(query)
      card.hidden = !matches
      if (matches) visible += 1
    }

    if (board) board.hidden = visible === 0
    if (empty) empty.hidden = visible !== 0
    if (output)
      output.value = `${visible} project${visible === 1 ? '' : 's'} visible`
  }

  search?.addEventListener('input', updateProjects)
  for (const clear of document.querySelectorAll(
    '[data-clear-project-search]',
  )) {
    clear.addEventListener('click', () => {
      if (search) search.value = ''
      updateProjects()
      search?.focus()
    })
  }
</script>

<script>
  import '@caderno-ui/elements/badge'
  import '@caderno-ui/elements/breadcrumb'
  import '@caderno-ui/elements/button'
  import '@caderno-ui/elements/empty-state'
  import '@caderno-ui/elements/icon'
  import '@caderno-ui/elements/kanban'
  import '@caderno-ui/elements/link'
  import '@caderno-ui/elements/table'
</script>
