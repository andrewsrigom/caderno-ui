---
import CodeBlock from '../components/CodeBlock.astro'
import DemoFrame from '../components/DemoFrame.astro'
import DocsLayout from '../layouts/DocsLayout.astro'

const install = `pnpm add @caderno-ui/elements @caderno-ui/tokens

# Optional framework adapters
pnpm add @caderno-ui/react     # React
pnpm add @caderno-ui/astro     # Astro

# Optional page animations
pnpm add @caderno-ui/motion`

const register = `import '@caderno-ui/tokens/notebook.css'
import '@caderno-ui/elements/alert'`

const markup = `<cad-alert heading="Ready" variant="info">
  Your notes are ready to edit.
</cad-alert>`

const eventExample = `import '@caderno-ui/elements/bookmark'

const bookmark = document.querySelector('cad-bookmark')

bookmark.addEventListener('cad-bookmark-change', (event) => {
  console.log(event.detail)
  // { active: true, id: 'architecture-notes' }
})`
---

<DocsLayout
  description="Install Caderno UI, register only the elements you need, and use its typed custom events."
  title="Getting started"
>
  <header class="page-header">
    <h1>Getting started</h1>
    <p>
      Install the packages, load the theme, and import the components you use.
    </p>
  </header>

  <p>
    These docs include the upcoming 0.5 release. npm currently provides 0.4.1.
    Check the <a href="https://github.com/andrewsrigom/caderno-ui/pull/3"
      >release status</a
    > before using the new integration contracts.
  </p>

  <ol class="steps" aria-label="Installation steps">
    <li>
      <span>1</span>
      <div>
        <h2>Install</h2>
        <p>
          Elements provides the components. Tokens provides their shared colors,
          fonts, and spacing. React, Astro, and motion packages are optional.
        </p>
      </div>
    </li>
  </ol>
  <CodeBlock code={install} language="shell" />

  <ol class="steps" start="2">
    <li>
      <span>2</span>
      <div>
        <h2>Import</h2>
        <p>
          Import each component by name to keep unused components out of your
          bundle. Load the theme once; it starts with a white background.
        </p>
      </div>
    </li>
  </ol>
  <CodeBlock code={register} language="typescript" />

  <ol class="steps" start="3">
    <li>
      <span>3</span>
      <div>
        <h2>Add markup</h2>
        <p>
          Use attributes for simple values and slots for content. Set arrays and
          objects as JavaScript properties.
        </p>
      </div>
    </li>
  </ol>
  <CodeBlock code={markup} language="html" />

  <DemoFrame title="Your first component">
    <cad-alert heading="Ready" variant="info">
      Your notes are ready to edit.
    </cad-alert>
  </DemoFrame>

  <section class="content-section" aria-labelledby="events-title">
    <h2 id="events-title">Handle events</h2>
    <p>
      Listen on the component or a parent element. Events bubble and cross
      shadow boundaries.
    </p>
    <CodeBlock code={eventExample} language="typescript" />
  </section>

  <aside class="callout">
    <strong>ES modules only</strong>
    Use a build tool that resolves package imports, such as Vite. Packages are ESM-only;
    bare package names do not work in an unconfigured HTML file.
  </aside>
</DocsLayout>

<script>
  import '@caderno-ui/elements/alert'
</script>
