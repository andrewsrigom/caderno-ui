---
import Button from '@caderno-ui/astro/Button.astro'
import Card from '@caderno-ui/astro/Card.astro'
import CardContent from '@caderno-ui/astro/CardContent.astro'
import CardTitle from '@caderno-ui/astro/CardTitle.astro'
import CodeBlock from '../components/CodeBlock.astro'
import DemoFrame from '../components/DemoFrame.astro'
import DocsLayout from '../layouts/DocsLayout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const install = 'pnpm add @caderno-ui/elements @caderno-ui/tokens'
const alertExample = `<cad-alert dismissible heading="Unsaved changes" variant="warning">
  Save your notes before leaving this page.
</cad-alert>

<script type="module">
  import '@caderno-ui/elements/alert'
</script>`
---

<DocsLayout
  description="Simple UI components inspired by handwritten notes on white paper. Works with HTML, React, Astro, Vue, and Svelte."
  title="Caderno UI"
>
  <section class="hero">
    <div>
      <h1>Caderno UI</h1>
      <p class="hero-copy">
        UI components with the feel of pen on white paper. For HTML, React,
        Astro, Vue, and Svelte.
      </p>
      <div class="hero-actions">
        <Button href={`${base}/getting-started/`}>Get started</Button>
        <Button variant="secondary" href={`${base}/components/`}>
          Explore components
        </Button>
        <Button variant="secondary" href={`${base}/demo/`}>
          Try the demo
        </Button>
      </div>
      <CodeBlock code={install} language="shell" />
    </div>
    <cad-note class="hero-note" heading="For tomorrow">
      Review the search results.<br />
      Bring questions to the meeting.
    </cad-note>
  </section>

  <section aria-labelledby="principles-title">
    <div class="section-heading">
      <h2 id="principles-title">How it works</h2>
    </div>
    <div class="feature-grid">
      <Card variant="outlined"
        ><CardContent>
          <cad-icon name="layers" size="26"></cad-icon>
          <CardTitle>Web components</CardTitle>
          <p>
            Use standard web components, with optional React and Astro adapters.
          </p>
        </CardContent></Card
      >
      <Card variant="outlined"
        ><CardContent>
          <cad-icon name="brackets" size="26"></cad-icon>
          <CardTitle>Slots</CardTitle>
          <p>
            Compose text, icons, and actions through slots. Keep your
            application logic separate.
          </p>
        </CardContent></Card
      >
      <Card variant="outlined"
        ><CardContent>
          <cad-icon name="spark" size="26"></cad-icon>
          <CardTitle>CSS variables</CardTitle>
          <p>Change colors, fonts, and spacing with CSS variables.</p>
        </CardContent></Card
      >
    </div>
  </section>

  <section aria-labelledby="product-demo-title">
    <div class="section-heading">
      <h2 id="product-demo-title">Try Field Notes</h2>
      <p>See the components together in a small app for projects and notes.</p>
      <cad-link href={`${base}/demo/`}>Open demo</cad-link>
    </div>
  </section>

  <DemoFrame title="Dismissible alert">
    <cad-alert dismissible heading="Unsaved changes" variant="warning">
      Save your notes before leaving this page.
    </cad-alert>
  </DemoFrame>
  <CodeBlock code={alertExample} language="html" collapsible />

  <section aria-labelledby="packages-title">
    <div class="section-heading">
      <h2 id="packages-title">Packages</h2>
    </div>
    <div class="package-grid">
      <Card variant="outlined"
        ><CardContent>
          <cad-icon name="box" size="25"></cad-icon>
          <CardTitle>@caderno-ui/elements</CardTitle>
          <p>Web components. Import only the ones you use.</p>
        </CardContent></Card
      >
      <Card variant="outlined"
        ><CardContent>
          <cad-icon name="highlight" size="25"></cad-icon>
          <CardTitle>@caderno-ui/tokens</CardTitle>
          <p>
            Colors, fonts, and spacing. White by default; dark mode is optional.
          </p>
        </CardContent></Card
      >
      <Card variant="outlined"
        ><CardContent>
          <cad-icon name="star" size="25"></cad-icon>
          <CardTitle>@caderno-ui/icons</CardTitle>
          <p>Hand-drawn SVG icons.</p>
        </CardContent></Card
      >
      <Card variant="outlined"
        ><CardContent>
          <cad-icon name="code" size="25"></cad-icon>
          <CardTitle>@caderno-ui/react</CardTitle>
          <p>React components with typed properties and events.</p>
        </CardContent></Card
      >
      <Card variant="outlined"
        ><CardContent>
          <cad-icon name="rocket" size="25"></cad-icon>
          <CardTitle>@caderno-ui/astro</CardTitle>
          <p>Astro components with server-rendered fallback content.</p>
        </CardContent></Card
      >
    </div>
  </section>
</DocsLayout>

<script>
  import '@caderno-ui/elements/alert'
  import '@caderno-ui/elements/icon'
  import '@caderno-ui/elements/link'
  import '@caderno-ui/elements/note'
</script>
