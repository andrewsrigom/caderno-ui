---
import DocsLayout from '../layouts/DocsLayout.astro'
import { integrations } from '../lib/integrations'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<DocsLayout
  title="Integrations"
  description="Installation, events, slots, and examples for each framework."
>
  <header class="page-header">
    <h1>Integrations</h1><p>Install and use Caderno UI with your framework.</p>
  </header>
  <section class="content-section" aria-label="Frameworks">
    <ul>
      {
        Object.entries(integrations).map(([key, guide]) => (
          <li>
            <a href={`${base}/integrations/${key}/`}>{guide.title}</a> —{' '}
            {guide.description}
          </li>
        ))
      }
    </ul>
  </section>
  <section class="content-section">
    <h2>Working examples</h2><p>
      <a href={`${base}/examples/react/`}>React / Next.js notes</a> · <a
        href={`${base}/examples/react/kanban/`}>Kanban board</a
      > · <a href={`${base}/integrations/recipes/`}>Copyable recipes</a> · <a
        href={`${base}/quality/`}>Validation and limitations</a
      >
    </p>
  </section>
</DocsLayout>
