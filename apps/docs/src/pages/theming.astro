---
import CodeBlock from '../components/CodeBlock.astro'
import DemoFrame from '../components/DemoFrame.astro'
import DocsLayout from '../layouts/DocsLayout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const themeImport = `import '@caderno-ui/tokens/notebook.css'`
const scrollbarImport = `import '@caderno-ui/elements/scrollbar.css'`
const override = `.product-surface {
  --cad-link: #6d35c5;
  --cad-post-it-blue-bg: #d9c8ff;
}`
const partExample = `cad-alert.release-note::part(base) {
  border-width: 2px;
}

cad-alert.release-note::part(title) {
  font-weight: 700;
}`

const colorTokens = [
  ['Lemon', '--cad-post-it-lemon-bg', '--cad-post-it-lemon-ink'],
  ['Pink', '--cad-post-it-pink-bg', '--cad-post-it-pink-ink'],
  ['Mint', '--cad-post-it-mint-bg', '--cad-post-it-mint-ink'],
  ['Blue', '--cad-post-it-blue-bg', '--cad-post-it-blue-ink'],
  ['Coral', '--cad-post-it-coral-bg', '--cad-post-it-coral-ink'],
  ['Violet', '--cad-sticker-violet-bg', '--cad-sticker-violet-ink'],
] as const
---

<DocsLayout
  description="Customize colors, fonts, and spacing. White by default, with optional dark mode."
  title="Theming"
>
  <header class="page-header">
    <h1>Theming</h1>
    <p>
      Change colors, fonts, and spacing with CSS variables. Use CSS parts to
      style specific parts of a component.
    </p>
  </header>

  <section class="content-section" aria-labelledby="defaults-title">
    <h2 id="defaults-title">Choose a theme</h2>
    <p>
      Import the theme once. The default is white, regardless of system
      preferences. Set <code>data-theme="dark"</code> on <code
        >&lt;html&gt;</code
      > for dark mode. Remove the attribute or set it to <code>light</code> to return
      to white.
    </p>
    <CodeBlock code={themeImport} language="typescript" />
  </section>

  <section class="content-section" aria-labelledby="palette-title">
    <h2 id="palette-title">Color pairs</h2>
    <p>
      Each pair defines a background and text color. Change them together and
      check contrast in both themes.
    </p>
    <div class="token-grid">
      {
        colorTokens.map(([name, background, color]) => (
          <article
            class="token-swatch"
            style={{ background: `var(${background})`, color: `var(${color})` }}
          >
            <strong>{name}</strong>
            <code>{background}</code>
            <code>{color}</code>
          </article>
        ))
      }
    </div>
  </section>

  <section class="content-section" aria-labelledby="scope-title">
    <h2 id="scope-title">Override variables</h2>
    <p>
      Set variables on the page, a container, or one component. Children inherit
      them.
    </p>
    <p>
      Use <code>--cad-font-text</code> for reading and UI,
      <code>--cad-font-hand</code> for annotations, and <code
        >--cad-font-mono</code
      >
      for code. See <a href={`${base}/typography/`}>Typography</a> for the full set.
    </p>
    <CodeBlock code={override} language="css" />
    <DemoFrame title="A locally themed alert">
      <div class="product-surface">
        <cad-alert heading="Scoped tokens" variant="info">
          Only this alert uses the purple accent.
        </cad-alert>
      </div>
    </DemoFrame>
  </section>

  <section class="content-section" aria-labelledby="parts-title">
    <h2 id="parts-title">Style public parts</h2>
    <p>
      Use <code>::part()</code> to style the parts listed in each component’s API.
    </p>
    <CodeBlock code={partExample} language="css" />
  </section>

  <section class="content-section" aria-labelledby="scrollbars-title">
    <h2 id="scrollbars-title">Scrollbars</h2>
    <p>
      Import once for blue scrollbars on the page and inside components.
      Scrolling stays native. Touch devices and high-contrast mode keep platform
      controls.
    </p>
    <CodeBlock code={scrollbarImport} language="typescript" />
    <p>
      Customize <code>--cad-scrollbar-thumb</code>,
      <code>--cad-scrollbar-thumb-hover</code>,
      <code>--cad-scrollbar-track</code>, and
      <code>--cad-scrollbar-size</code> (10px by default). Firefox uses its native
      thin width and shape.
    </p>
  </section>

  <style>
    .product-surface {
      --cad-link: #6d35c5;
      --cad-post-it-blue-bg: #d9c8ff;
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/alert'
</script>
