---
import CodeBlock from '../components/CodeBlock.astro'
import DemoFrame from '../components/DemoFrame.astro'
import ExampleCard from '../components/ExampleCard.astro'
import ExampleGallery from '../components/ExampleGallery.astro'
import DocsLayout from '../layouts/DocsLayout.astro'
import '@caderno-ui/elements/prose.css'

const proseUsage = `<article class="cad-prose">
  <h2>Record the decision</h2>
  <p>Use a <code>Map</code> when repeated lookups need a clear index.</p>
  <h3>Check the contract</h3>
  <ul>
    <li>Define the input.</li>
    <li>Keep the result predictable.</li>
  </ul>
</article>`

const tokensUsage = `<link rel="stylesheet" href="@caderno-ui/tokens/notebook.css" />
<link rel="stylesheet" href="@caderno-ui/elements/typography.css" />

<h1 class="cad-type-display">Search indexing strategy</h1>
<h2 class="cad-type-heading">Compare the options</h2>
<h3 class="cad-type-title">Query latency by option</h3>
<p class="cad-type-label">Review status</p>
<p class="cad-type-body">Compare query speed, storage cost, and recovery time before choosing an index.</p>
<p class="cad-type-meta">Updated today · 6 minutes to review</p>
<code class="cad-type-code">latencyP95 &lt; 100</code>`

const listUsage = `<cad-list label="Architecture topics">
  <cad-list-item>Query latency</cad-list-item>
  <cad-list-item>Search indexing</cad-list-item>
  <cad-list-item>Failure recovery</cad-list-item>
</cad-list>

<cad-list label="Decision sequence" variant="numbered">
  <cad-list-item>Frame the question</cad-list-item>
  <cad-list-item>Compare the evidence</cad-list-item>
  <cad-list-item>Record the decision</cad-list-item>
</cad-list>`
---

<DocsLayout
  description="Shared fonts, text sizes, and list styles for Caderno UI."
  title="Typography"
>
  <header class="page-header">
    <h1>Typography</h1>
    <p>
      Three font families: one for reading and UI, one for handwritten labels
      and emphasis, and one for code.
    </p>
  </header>

  <section class="content-section" aria-labelledby="font-families-title">
    <h2 id="font-families-title">Font families</h2>
    <ul>
      <li>
        <code>--cad-font-text</code>: body text and UI. <code
          >--cad-font-ui</code
        > and <code>--cad-font-book</code> are aliases.
      </li>
      <li>
        <code>--cad-font-hand</code>: annotations, labels, and component titles.
      </li>
      <li><code>--cad-font-mono</code>: code and technical values.</li>
    </ul>
    <p>
      The theme defines font stacks, not font files. Load your chosen fonts in
      the application to keep the appearance consistent across devices.
    </p>
  </section>

  <DemoFrame
    title="Typographic roles"
    description="Import typography.css and apply a text role to any HTML element."
  >
    <div class="type-specimens">
      <div class="type-specimen">
        <span>Display</span>
        <p class="cad-type-display">Search indexing strategy</p>
      </div>
      <div class="type-specimen">
        <span>Section heading</span>
        <p class="cad-type-heading">Compare the options</p>
      </div>
      <div class="type-specimen">
        <span>Component title</span>
        <p class="cad-type-title">Query latency by option</p>
      </div>
      <div class="type-specimen">
        <span>Label and emphasis</span>
        <p class="cad-type-label">Review status</p>
      </div>
      <div class="type-specimen">
        <span>Body and UI</span>
        <p class="cad-type-body">
          Compare query speed, storage cost, and recovery time before choosing
          an index.
        </p>
      </div>
      <div class="type-specimen">
        <span>Metadata</span>
        <p class="cad-type-meta">Updated today · 6 minutes to review</p>
      </div>
      <div class="type-specimen">
        <span>Code</span>
        <p class="cad-type-code"><code>latencyP95 &lt; 100</code></p>
      </div>
    </div>
  </DemoFrame>
  <CodeBlock code={tokensUsage} collapsible language="html" />

  <ExampleGallery
    id="structured-lists-title"
    title="Lists"
    description="Use bullets to group related items and numbers to show order."
  >
    <ExampleCard title="Bullet list">
      <cad-list label="Architecture topics">
        <cad-list-item>Query latency</cad-list-item>
        <cad-list-item>Search indexing</cad-list-item>
        <cad-list-item>Failure recovery</cad-list-item>
      </cad-list>
    </ExampleCard>
    <ExampleCard title="Numbered list">
      <cad-list label="Decision sequence" variant="numbered">
        <cad-list-item>Frame the question</cad-list-item>
        <cad-list-item>Compare the evidence</cad-list-item>
        <cad-list-item>Record the decision</cad-list-item>
      </cad-list>
    </ExampleCard>
  </ExampleGallery>
  <CodeBlock code={listUsage} collapsible language="html" />

  <DemoFrame
    title="Article content"
    description="Import prose.css for headings, paragraphs, links, and native lists. Use components for notes, code blocks, and accordions."
  >
    <article
      class="cad-prose"
      set:html={proseUsage.replace(/^<article[^>]*>\n|\n<\/article>$/g, '')}
    />
  </DemoFrame>
  <CodeBlock code={proseUsage} collapsible language="html" />

  <section class="content-section" aria-labelledby="stroke-title">
    <h2 id="stroke-title">Borders and underlines</h2>
    <div class="stroke-grid">
      <div class="stroke-sample dashed">
        <strong>Dashed blue</strong>
        <span>Frames, fields, selection, and keyboard focus.</span>
      </div>
      <div class="stroke-sample solid">
        <strong>Solid blue</strong>
        <span>Action buttons.</span>
      </div>
      <div class="stroke-sample underline">
        <strong>Coral underline</strong>
        <span>Links and breadcrumb links.</span>
      </div>
    </div>
  </section>

  <style>
    .type-specimens {
      display: grid;
      width: 100%;
      gap: 0;
    }

    .type-specimen {
      display: grid;
      grid-template-columns: minmax(8.5rem, 0.3fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: baseline;
      padding-block: 1rem;
      border-bottom: var(--cad-frame-border-subtle);
    }

    .type-specimen:last-child {
      border-bottom: 0;
    }

    .type-specimen > span {
      color: var(--cad-ink-muted);
      font: var(--cad-type-meta-size) / var(--cad-type-meta-line-height)
        var(--cad-type-meta-font);
    }

    .type-specimen p {
      margin: 0;
    }

    .stroke-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .stroke-sample {
      position: relative;
      display: grid;
      gap: 0.35rem;
      min-height: 8rem;
      align-content: center;
      padding: 1.1rem;
      color: var(--cad-link);
      background: var(--cad-surface);
    }

    .stroke-sample strong {
      font-family: var(--cad-type-title-font);
      font-size: var(--cad-type-label-size);
    }

    .stroke-sample span {
      color: var(--cad-ink-muted);
      font-family: var(--cad-type-meta-font);
      font-size: var(--cad-type-meta-size);
    }

    .stroke-sample.dashed {
      border: var(--cad-frame-border);
    }

    .stroke-sample.solid {
      border: var(--cad-border-width) solid var(--cad-border-ink);
    }

    .stroke-sample.underline {
      border-bottom: 3px solid var(--cad-link-mark);
    }

    @media (width <= 44rem) {
      .type-specimen,
      .stroke-grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
</DocsLayout>

<script>
  import '@caderno-ui/elements/list'
</script>
