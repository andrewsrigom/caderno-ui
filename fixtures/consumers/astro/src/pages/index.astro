---
import '@caderno-ui/tokens/notebook.css'

import Alert from '@caderno-ui/astro/Alert.astro'
import Badge from '@caderno-ui/astro/Badge.astro'
import Bookmark from '@caderno-ui/astro/Bookmark.astro'
import Breadcrumb from '@caderno-ui/astro/Breadcrumb.astro'
import BreadcrumbItem from '@caderno-ui/astro/BreadcrumbItem.astro'
import Input from '@caderno-ui/astro/Input.astro'
import List from '@caderno-ui/astro/List.astro'
import ListItem from '@caderno-ui/astro/ListItem.astro'
import Card from '@caderno-ui/astro/Card.astro'
import Chart from '@caderno-ui/astro/Chart.astro'
import ChartItem from '@caderno-ui/astro/ChartItem.astro'
import Drawer from '@caderno-ui/astro/Drawer.astro'
import Footer from '@caderno-ui/astro/Footer.astro'
import FooterGroup from '@caderno-ui/astro/FooterGroup.astro'
import Header from '@caderno-ui/astro/Header.astro'
import Note from '@caderno-ui/astro/Note.astro'
import Popover from '@caderno-ui/astro/Popover.astro'
import Progress from '@caderno-ui/astro/Progress.astro'
import Slider from '@caderno-ui/astro/Slider.astro'
import Step from '@caderno-ui/astro/Step.astro'
import Steps from '@caderno-ui/astro/Steps.astro'
import Switch from '@caderno-ui/astro/Switch.astro'
import TabContent from '@caderno-ui/astro/TabContent.astro'
import TabsList from '@caderno-ui/astro/TabsList.astro'
import TabTrigger from '@caderno-ui/astro/TabTrigger.astro'
import Tabs from '@caderno-ui/astro/Tabs.astro'
---

<!doctype html>
<html lang="en">
  <head><title>Caderno UI packed Astro consumer</title></head>
  <body>
    <Header label="Packed Astro header">
      <strong slot="brand">Caderno UI</strong>
      <a href="/components">Components</a>
    </Header>
    <Alert title="Packed Astro facade">Static fallback remains readable.</Alert>
    <Badge tone="mint">Ready</Badge>
    <Breadcrumb items={[{ href: '/', label: 'Home' }, { label: 'Fixture' }]} />
    <Breadcrumb label="Composed path">
      <BreadcrumbItem href="/" current={false}>Home</BreadcrumbItem>
      <BreadcrumbItem current>Fixture</BreadcrumbItem>
    </Breadcrumb>
    <List
      ><ListItem href="/fixture">Not current</ListItem><ListItem current
        >Current</ListItem
      ></List
    >
    <List label="Compact composition" compact>
      <ListItem>Static content</ListItem>
      <ListItem
        ><a {...{ slot: 'action' }} href="/notes">Open notes</a></ListItem
      >
      <ListItem
        ><button {...{ slot: 'action' }} type="button">Save note</button
        ></ListItem
      >
    </List>
    <Input label="Valid input" invalid={false} />
    <Bookmark id="packed" label="Save packed fixture" />
    <Note heading="Packed note">Static note content.</Note>
    <button id="packed-popover-trigger" type="button">Open context</button>
    <Popover anchor="packed-popover-trigger" heading="Packed popover">
      Static popover content.
    </Popover>
    <Drawer heading="Packed drawer" placement="right">
      Static drawer content.
    </Drawer>
    <Progress label="Packed progress" value={75} />
    <Slider label="Packed slider" name="packed-slider" value={64} />
    <Switch checked label="Packed switch" name="packed-switch" />
    <Steps label="Packed method">
      <Step>
        <Fragment slot="title"><h3>Contract</h3></Fragment>
        <span slot="marker">A</span>
        <p>Define the behavior.</p>
        <span slot="meta">2 minutes</span>
        <span slot="status">Ready</span>
      </Step>
      <Step title="Verify">Check the evidence.</Step>
    </Steps>
    <Chart heading="Packed chart">
      <ChartItem label="Notes" value={4}>Notes: 4</ChartItem>
    </Chart>
    <Tabs defaultValue="notes">
      <TabsList label="Packed tabs">
        <TabTrigger label="Notes" value="notes">Notes</TabTrigger>
      </TabsList>
      <TabContent value="notes">
        <Card folded={false}>Static tab content.</Card>
      </TabContent>
    </Tabs>
    <Footer label="Packed Astro footer">
      <strong slot="brand">Caderno UI</strong>
      <FooterGroup heading="Product">
        <a href="/components">Components</a>
      </FooterGroup>
      <small slot="bottom">Packed Astro consumer</small>
    </Footer>
  </body>
</html>
