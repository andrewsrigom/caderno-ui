---
import '@caderno-ui/tokens/notebook.css'

import Alert from '@caderno-ui/astro/Alert.astro'
import Badge from '@caderno-ui/astro/Badge.astro'
import Bookmark from '@caderno-ui/astro/Bookmark.astro'
import Chart from '@caderno-ui/astro/Chart.astro'
import ChartItem from '@caderno-ui/astro/ChartItem.astro'
import Note from '@caderno-ui/astro/Note.astro'
import Paper from '@caderno-ui/astro/Paper.astro'
import Progress from '@caderno-ui/astro/Progress.astro'
import TabContent from '@caderno-ui/astro/TabContent.astro'
import TabsList from '@caderno-ui/astro/TabsList.astro'
import TabTrigger from '@caderno-ui/astro/TabTrigger.astro'
import Tabs from '@caderno-ui/astro/Tabs.astro'
---

<!doctype html>
<html lang="en">
  <head><title>Caderno UI packed Astro consumer</title></head>
  <body>
    <Alert title="Packed Astro facade">Static fallback remains readable.</Alert>
    <Badge tone="mint">Ready</Badge>
    <Bookmark id="packed" label="Save packed fixture" />
    <Note heading="Packed note">Static note content.</Note>
    <Progress label="Packed progress" value={75} />
    <Chart heading="Packed chart">
      <ChartItem label="Notes" value={4}>Notes: 4</ChartItem>
    </Chart>
    <Tabs defaultValue="notes">
      <TabsList label="Packed tabs">
        <TabTrigger label="Notes" value="notes">Notes</TabTrigger>
      </TabsList>
      <TabContent value="notes">
        <Paper margin pattern="ruled">Static tab content.</Paper>
      </TabContent>
    </Tabs>
  </body>
</html>
