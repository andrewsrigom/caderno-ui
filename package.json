{
  "name": "caderno-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Framework-agnostic notebook-inspired UI built with Lit.",
  "author": "Andrews Ribeiro Gomes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewsrigom/caderno-ui.git"
  },
  "homepage": "https://github.com/andrewsrigom/caderno-ui#readme",
  "bugs": {
    "url": "https://github.com/andrewsrigom/caderno-ui/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "adapters:check": "node scripts/generate-adapters.mjs",
    "adapters:generate": "node scripts/generate-adapters.mjs --write && prettier --write packages/react/src",
    "api:check": "node scripts/run-api-extractor.mjs",
    "api:report": "pnpm build && node scripts/run-api-extractor.mjs --update",
    "build": "pnpm --filter './packages/*' --workspace-concurrency=1 -r --if-present build && pnpm --filter './apps/*' -r --if-present build",
    "build:core": "pnpm --filter @caderno-ui/icons build && pnpm --filter @caderno-ui/elements build && pnpm --filter @caderno-ui/motion build",
    "bundle:baseline": "pnpm build && node scripts/check-bundles.mjs --update",
    "bundle:check": "pnpm build && node scripts/check-bundles.mjs",
    "changeset:check": "node scripts/check-changeset.mjs",
    "check:packages": "pnpm build && pnpm api:check && pnpm contract:check && pnpm pack:check && pnpm bundle:check && pnpm lint:packages",
    "check:static": "pnpm build:core && pnpm format:check && pnpm lint && pnpm changeset:check && pnpm adapters:check && pnpm composition:check && pnpm tokens:check && pnpm test:authoring && pnpm typecheck",
    "composition:check": "node scripts/check-composition.mjs",
    "contract:check": "node scripts/check-manifest.mjs && node scripts/check-contracts.mjs",
    "consumers:check": "pnpm pack:check && pnpm test:consumers",
    "create:component": "node scripts/create-component.mjs",
    "dev": "pnpm --filter @caderno-ui/laboratory dev",
    "docs:dev": "pnpm --filter @caderno-ui/docs dev",
    "docs:check": "pnpm build:core && node scripts/check-docs.mjs && pnpm --filter @caderno-ui/docs build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:code && pnpm lint:styles",
    "lint:code": "eslint .",
    "lint:code:fix": "eslint . --fix",
    "lint:packages": "pnpm --recursive --filter './packages/*' exec publint",
    "lint:styles": "stylelint \"**/*.css\"",
    "lint:styles:fix": "stylelint \"**/*.css\" --fix",
    "manifest": "cem analyze --litelement --globs \"packages/elements/src/**/*.ts\" --outdir packages/elements && node scripts/normalize-manifest.mjs",
    "pack:baseline": "pnpm build && node scripts/check-packs.mjs --update",
    "pack:check": "pnpm build && node scripts/check-packs.mjs",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "security:audit": "pnpm audit --audit-level high",
    "security:check": "pnpm security:audit && node scripts/check-licenses.mjs && node scripts/check-supply-chain.mjs",
    "test": "pnpm build:core && pnpm -r --if-present test",
    "test:a11y": "pnpm build:core && playwright test e2e/accessibility.spec.ts",
    "test:authoring": "node scripts/test-create-component.mjs",
    "test:browser": "pnpm --filter @caderno-ui/elements test:browser",
    "test:docs": "pnpm exec playwright test --config playwright.docs.config.ts",
    "test:consumers": "node scripts/check-consumers.mjs",
    "test:e2e": "pnpm build:core && playwright test",
    "test:platform": "pnpm build:core && playwright test e2e/platform-modes.spec.ts",
    "test:visual": "pnpm build:core && playwright test e2e/visual.spec.ts --project=chromium",
    "tokens:check": "node scripts/check-tokens.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm check:static && pnpm check:packages && pnpm test && pnpm test:e2e && pnpm docs:check && pnpm security:check",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.1",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "publint": "^0.3.12",
    "rimraf": "^6.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tar": "^7.5.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "rs-module-lexer"
    ]
  },
  "customElements": ".artifacts/manifest/custom-elements.json"
}
