---
import '@caderno-ui/elements/fallback.css'

import type {
  CadAccordionAnimation,
  CadAccordionTone,
} from '@caderno-ui/elements/accordion'

type Props = {
  animation?: CadAccordionAnimation
  class?: string
  disabled?: boolean
  open?: boolean
  title: string
  tone?: CadAccordionTone
}

const {
  animation = 'collapse',
  class: className,
  disabled = false,
  open = false,
  title,
  tone = 'blue',
} = Astro.props
---

<cad-accordion-item
  animation={animation}
  class={className}
  disabled={disabled || undefined}
  heading={title}
  open={open || undefined}
  tone={tone}
>
  <span slot="title">{title}</span>
  <slot />
</cad-accordion-item>

<script>
  import '@caderno-ui/elements/accordion'
</script>
