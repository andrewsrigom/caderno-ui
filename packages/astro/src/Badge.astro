---
import '@caderno-ui/elements/fallback.css'

import type { CadBadgeTone, CadBadgeVariant } from '@caderno-ui/elements/badge'

type Props = {
  class?: string
  tone?: CadBadgeTone
  variant?: CadBadgeVariant
}

const { class: className, tone = 'neutral', variant = 'solid' } = Astro.props
---

<cad-badge class={className} tone={tone} variant={variant}>
  <slot name="start" slot="start" />
  <slot />
</cad-badge>

<script>
  import '@caderno-ui/elements/badge'
</script>
