---
import '@caderno-ui/elements/fallback.css'
import type {
  CadBlockquoteTone,
  CadBlockquoteVariant,
} from '@caderno-ui/elements/blockquote'

type Props = {
  author?: string
  cite?: string
  class?: string
  source?: string
  tone?: CadBlockquoteTone
  variant?: CadBlockquoteVariant
}

const {
  author,
  cite,
  class: className,
  source,
  tone = 'accent',
  variant = 'default',
} = Astro.props
---

<cad-blockquote
  author={author}
  cite={cite}
  class={className}
  source={source}
  tone={tone}
  variant={variant}
>
  <slot />
  <slot name="caption" slot="caption" />
</cad-blockquote>

<script>
  import '@caderno-ui/elements/blockquote'
</script>
