---
import '@caderno-ui/elements/fallback.css'

type BreadcrumbItem = {
  current?: boolean
  href?: string
  label: string
  rel?: string
  target?: string
}
type Props = {
  class?: string
  items?: BreadcrumbItem[]
  label?: string
  variant?: 'compact' | 'default'
}

const {
  class: className,
  items = [],
  label = 'Breadcrumb',
  variant = 'default',
} = Astro.props
---

<cad-breadcrumb class={className} label={label} variant={variant}>
  {
    items.map((item, index) => (
      <cad-breadcrumb-item
        current={
          item.current ||
          (!items.some((candidate) => candidate.current) &&
            index === items.length - 1)
        }
        href={item.href}
        rel={item.rel}
        target={item.target}
      >
        {item.label}
      </cad-breadcrumb-item>
    ))
  }
  <slot />
</cad-breadcrumb>

<script>
  import '@caderno-ui/elements/breadcrumb'
</script>
