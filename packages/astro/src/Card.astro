---
import '@caderno-ui/elements/fallback.css'

import type { CadCardTone, CadCardVariant } from '@caderno-ui/elements/card'

type Props = {
  class?: string
  folded?: boolean
  href?: string
  tone?: CadCardTone
  variant?: CadCardVariant
}

const {
  class: className,
  folded = false,
  href,
  tone = 'neutral',
  variant = 'paper',
} = Astro.props
---

<cad-card
  class={className}
  folded={folded || undefined}
  href={href}
  tone={tone}
  variant={variant}
>
  <slot />
</cad-card>

<script>
  import '@caderno-ui/elements/card'
</script>
