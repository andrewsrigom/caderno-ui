---
import '@caderno-ui/elements/fallback.css'

import type { CadCheckboxTone } from '@caderno-ui/elements/checkbox'

type Props = {
  checked?: boolean
  class?: string
  disabled?: boolean
  hint?: string
  id?: string
  label: string
  name?: string
  required?: boolean
  tone?: CadCheckboxTone
  value?: string
}

const {
  checked = false,
  class: className,
  disabled = false,
  hint,
  id,
  label,
  name,
  required = false,
  tone = 'blue',
  value = 'on',
} = Astro.props
---

<cad-checkbox
  checked={checked || undefined}
  class={className}
  disabled={disabled || undefined}
  hint={hint}
  id={id}
  label={label}
  name={name}
  required={required || undefined}
  tone={tone}
  value={value}
>
  <span slot="label">{label}</span>
  {hint ? <span slot="hint">{hint}</span> : null}
</cad-checkbox>

<script>
  import '@caderno-ui/elements/checkbox'
</script>
