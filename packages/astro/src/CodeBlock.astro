---
import '@caderno-ui/elements/fallback.css'
import type { CadCodeBlockTone } from '@caderno-ui/elements/code-block'

type Props = {
  class?: string
  code?: string
  copyable?: boolean
  copyLabel?: string
  copiedLabel?: string
  copyErrorLabel?: string
  filename?: string
  language?: string
  showLineNumbers?: boolean
  tone?: CadCodeBlockTone
}

const {
  class: className,
  code,
  copyable = false,
  copyLabel,
  copiedLabel,
  copyErrorLabel,
  filename,
  language,
  showLineNumbers = false,
  tone = 'accent',
} = Astro.props
---

<cad-code-block
  class={className}
  code={code}
  copyable={copyable || undefined}
  copy-label={copyLabel}
  copied-label={copiedLabel}
  copy-error-label={copyErrorLabel}
  filename={filename}
  language={language}
  show-line-numbers={showLineNumbers || undefined}
  tone={tone}
>
  <slot />
  {
    Astro.slots.has('actions') && (
      <span slot="actions">
        <slot name="actions" />
      </span>
    )
  }
</cad-code-block>

<script>
  import '@caderno-ui/elements/code-block'
</script>
