---
import '@caderno-ui/elements/fallback.css'

import type {
  CadLinkCurrent,
  CadLinkTone,
  CadLinkVariant,
} from '@caderno-ui/elements/link'

type Props = {
  class?: string
  current?: CadLinkCurrent
  disabled?: boolean
  download?: string
  external?: boolean
  href: string
  label?: string
  rel?: string
  target?: string
  tone?: CadLinkTone
  variant?: CadLinkVariant
}

const {
  class: className,
  current,
  disabled = false,
  download,
  external = false,
  href,
  label,
  rel,
  target,
  tone = 'blue',
  variant = 'underline',
} = Astro.props
---

<cad-link
  aria-current={current}
  class={className}
  disabled={disabled || undefined}
  download={download}
  external={external || undefined}
  href={href}
  label={label}
  rel={rel}
  target={target}
  tone={tone}
  variant={variant}
>
  {
    Astro.slots.has('start') && (
      <span slot="start">
        <slot name="start" />
      </span>
    )
  }
  <slot />
  {
    Astro.slots.has('end') && (
      <span slot="end">
        <slot name="end" />
      </span>
    )
  }
</cad-link>

<script>
  import '@caderno-ui/elements/link'
</script>
