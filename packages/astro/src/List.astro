---
import '@caderno-ui/elements/fallback.css'
import type { CadListVariant } from '@caderno-ui/elements/list'

type Props = {
  class?: string
  compact?: boolean
  label?: string
  variant?: CadListVariant
}

const {
  class: className,
  compact = false,
  label = 'List',
  variant = 'bullet',
} = Astro.props
---

<cad-list
  class={className}
  compact={compact || undefined}
  label={label}
  variant={variant}
>
  <slot />
</cad-list>

<script>
  import '@caderno-ui/elements/list'
</script>
