---
import '@caderno-ui/elements/fallback.css'

import type {
  CadPaperElevation,
  CadPaperPattern,
  CadPaperSpacing,
  CadPaperTone,
} from '@caderno-ui/elements/paper'

type Props = {
  class?: string
  elevation?: CadPaperElevation
  margin?: boolean
  pattern?: CadPaperPattern
  spacing?: CadPaperSpacing
  tone?: CadPaperTone
}

const {
  class: className,
  elevation = 'flat',
  margin = false,
  pattern = 'ruled',
  spacing = 'regular',
  tone = 'paper',
} = Astro.props
---

<cad-paper
  class={className}
  elevation={elevation}
  margin={margin || undefined}
  pattern={pattern}
  spacing={spacing}
  tone={tone}
>
  <slot />
</cad-paper>

<script>
  import '@caderno-ui/elements/paper'
</script>
