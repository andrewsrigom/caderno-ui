---
import '@caderno-ui/elements/fallback.css'

import type {
  CadSpinnerSize,
  CadSpinnerTone,
  CadSpinnerVariant,
} from '@caderno-ui/elements/spinner'

type Props = {
  class?: string
  label: string
  size?: CadSpinnerSize
  tone?: CadSpinnerTone
  variant?: CadSpinnerVariant
}

const {
  class: className,
  label,
  size = 'md',
  tone = 'blue',
  variant = 'ring',
}: Props = Astro.props
---

<cad-spinner
  class={className}
  label={label}
  size={size}
  tone={tone}
  variant={variant}>{label}</cad-spinner
>

<script>
  import '@caderno-ui/elements/spinner'
</script>
