---
import '@caderno-ui/elements/fallback.css'
import type { CadStepStatus } from '@caderno-ui/elements/steps'

type Props = {
  class?: string
  status?: CadStepStatus
  statusLabel?: string
  title?: string
  value?: string
}
const {
  class: className,
  status = 'pending',
  statusLabel,
  title,
  value,
} = Astro.props
// Spread DOM slot attributes so Astro 5 preserves them inside conditionals.
---

<cad-step
  class={className}
  status={status}
  status-label={statusLabel}
  title={title}
  value={value}
>
  {
    Astro.slots.has('marker') && (
      <span {...{ slot: 'marker' }}>
        <slot name="marker" />
      </span>
    )
  }
  {
    Astro.slots.has('title') && (
      <div {...{ slot: 'title' }}>
        <slot name="title" />
      </div>
    )
  }
  <slot />
  {
    Astro.slots.has('meta') && (
      <div {...{ slot: 'meta' }}>
        <slot name="meta" />
      </div>
    )
  }
  {
    Astro.slots.has('status') && (
      <span {...{ slot: 'status' }}>
        <slot name="status" />
      </span>
    )
  }
</cad-step>

<script>
  import '@caderno-ui/elements/steps'
</script>
