---
import '@caderno-ui/elements/fallback.css'
import type { CadStepStatus } from '@caderno-ui/elements/steps'

type Props = {
  class?: string
  status?: CadStepStatus
  statusLabel?: string
  title?: string
  value?: string
}
const {
  class: className,
  status = 'pending',
  statusLabel,
  title,
  value,
} = Astro.props
---

<cad-step
  class={className}
  status={status}
  status-label={statusLabel}
  title={title}
  value={value}
>
  <slot name="marker" slot="marker" />
  <slot name="title" slot="title" />
  <slot />
  <slot name="meta" slot="meta" />
  <slot name="status" slot="status" />
</cad-step>

<script>
  import '@caderno-ui/elements/steps'
</script>
