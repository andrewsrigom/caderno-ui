---
import '@caderno-ui/elements/fallback.css'
import type {
  CadStickerShape,
  CadStickerSize,
  CadStickerTone,
} from '@caderno-ui/elements/sticker'

type Props = {
  class?: string
  label?: string
  shape?: CadStickerShape
  size?: CadStickerSize
  tone?: CadStickerTone
}
const {
  class: className,
  label,
  shape = 'label',
  size = 'md',
  tone = 'blue',
} = Astro.props
---

<cad-sticker
  class={className}
  label={label}
  shape={shape}
  size={size}
  tone={tone}
  ><slot name="start" slot="start" /><slot>{label}</slot></cad-sticker
>

<script>
  import '@caderno-ui/elements/sticker'
</script>
