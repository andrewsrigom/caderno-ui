---
import '@caderno-ui/elements/fallback.css'
import type { CadSwitchSize } from '@caderno-ui/elements/switch'

type Props = {
  checked?: boolean
  class?: string
  disabled?: boolean
  hint?: string
  id?: string
  label: string
  name?: string
  required?: boolean
  size?: CadSwitchSize
  value?: string
}

const {
  checked = false,
  class: className,
  disabled = false,
  hint,
  id,
  label,
  name,
  required = false,
  size = 'md',
  value = 'on',
} = Astro.props
---

<cad-switch
  checked={checked}
  class={className}
  disabled={disabled}
  hint={hint}
  id={id}
  label={label}
  name={name}
  required={required}
  size={size}
  value={value}
>
  <span slot="label">{label}</span>
  {hint ? <span slot="hint">{hint}</span> : null}
</cad-switch>

<script>
  import '@caderno-ui/elements/switch'
</script>
