---
export type TableOfContentsItem = { id: string; level?: 2 | 3; title: string }
type Props = {
  ariaLabel?: string
  class?: string
  items?: TableOfContentsItem[]
  selector?: string
  sticky?: boolean
  title?: string
}
const {
  ariaLabel = 'On this page',
  class: className,
  items = [],
  selector = 'article h2, article h3',
  sticky = false,
  title = 'On this page',
}: Props = Astro.props
---

<nav
  aria-label={ariaLabel}
  class:list={['cad-toc', className]}
  data-cad-toc
  data-selector={selector}
  data-sticky={sticky ? 'true' : 'false'}
>
  <p class="cad-toc__title">{title}</p>
  <ol class="cad-toc__list">
    {
      items.map((item, index) => (
        <li data-level={item.level ?? 2}>
          <a
            aria-current={index === 0 ? 'location' : undefined}
            href={`#${item.id}`}
          >
            {item.title}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
<script>
  const slug = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '')
  function installCadernoTocs() {
    for (const toc of document.querySelectorAll<HTMLElement>(
      '[data-cad-toc]',
    )) {
      if (toc.dataset.ready === 'true') continue
      const selector = toc.dataset.selector
      const list = toc.querySelector<HTMLOListElement>('.cad-toc__list')
      if (!selector || !list) continue
      const headings = Array.from(
        document.querySelectorAll<HTMLElement>(selector),
      )
      if (list.children.length === 0)
        headings.forEach((heading, index) => {
          if (!heading.id)
            heading.id =
              slug(heading.textContent ?? '') || `section-${index + 1}`
          const item = document.createElement('li')
          const link = document.createElement('a')
          item.dataset.level = heading.tagName === 'H3' ? '3' : '2'
          link.href = `#${heading.id}`
          link.textContent = heading.textContent?.trim() ?? heading.id
          item.append(link)
          list.append(item)
        })
      const links = Array.from(
        list.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'),
      )
      const targets = links
        .map((link) =>
          document.getElementById(decodeURIComponent(link.hash.slice(1))),
        )
        .filter(
          (heading): heading is HTMLElement => heading instanceof HTMLElement,
        )
      const setActive = (id: string) =>
        links.forEach((link) =>
          link.hash === `#${id}`
            ? link.setAttribute('aria-current', 'location')
            : link.removeAttribute('aria-current'),
        )
      if (targets.length > 0 && 'IntersectionObserver' in window) {
        const visible = new Map<string, number>()
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) =>
              entry.isIntersecting
                ? visible.set(entry.target.id, entry.boundingClientRect.top)
                : visible.delete(entry.target.id),
            )
            const active = [...visible.entries()].sort(
              (left, right) => Math.abs(left[1]) - Math.abs(right[1]),
            )[0]
            if (active) setActive(active[0])
          },
          { rootMargin: '-18% 0px -68% 0px', threshold: [0, 1] },
        )
        targets.forEach((target) => observer.observe(target))
      }
      toc.dataset.ready = 'true'
    }
  }
  installCadernoTocs()
  document.addEventListener('astro:page-load', installCadernoTocs)
</script>
<style>
  .cad-toc {
    position: relative;
    display: grid;
    gap: 0.55rem;
    padding: 0.35rem 0 0.4rem 1rem;
    color: var(--cad-ink, currentColor);
    background: transparent;
    border: 0;
    border-inline-start: 1px dashed
      color-mix(in srgb, var(--cad-link, #005bac) 36%, transparent);
    border-radius: 0;
  }
  .cad-toc::before {
    position: absolute;
    inset-block: 0.25rem 0.35rem;
    inset-inline-start: 0.18rem;
    border-inline-start: 1px solid
      color-mix(in srgb, var(--cad-link, #005bac) 18%, transparent);
    content: '';
    pointer-events: none;
    transform: rotate(0.25deg);
  }
  .cad-toc[data-sticky='true'] {
    position: sticky;
    top: 1rem;
  }
  .cad-toc__title {
    position: relative;
    width: fit-content;
    padding: 0 0.18rem 0.3rem;
    margin: 0;
    color: var(--cad-link, #005bac);
    border: 0;
    font-family: var(--cad-font-hand, cursive);
    font-size: var(--cad-hand-md, 1.2rem);
    font-weight: var(--cad-hand-weight-strong, 700);
    line-height: 1.15;
  }
  .cad-toc__title::after {
    position: absolute;
    right: 12%;
    bottom: 0.08rem;
    left: 0;
    height: 2px;
    background: var(--cad-post-it-coral-bg, #ff665c);
    content: '';
    transform: rotate(-0.8deg);
  }
  .cad-toc__list {
    display: grid;
    gap: 0.12rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .cad-toc__list li[data-level='3'] {
    padding-left: 0.85rem;
  }
  .cad-toc__list a {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 0.3rem 0.48rem;
    overflow-wrap: anywhere;
    color: var(--cad-ink, currentColor);
    font-family: var(--cad-font-book, serif);
    font-size: 0.92rem;
    line-height: 1.3;
    text-decoration: none;
  }
  .cad-toc__list a:hover {
    color: var(--cad-link, currentColor);
    text-decoration: underline;
    text-decoration-color: var(--cad-post-it-coral-bg, #ff665c);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22rem;
  }
  .cad-toc__list a[aria-current='location'] {
    color: var(--cad-link, #005bac);
    background: color-mix(
      in srgb,
      var(--cad-post-it-blue-bg, #cfe2ff) 48%,
      transparent
    );
    border-inline-start: 2px solid var(--cad-link, #005bac);
    font-family: var(--cad-font-book, serif);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }
  .cad-toc__list a:focus-visible {
    outline: 2px dashed var(--cad-focus-ring, currentColor);
    outline-offset: 3px;
  }
</style>
