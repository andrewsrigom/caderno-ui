---
import '@caderno-ui/elements/fallback.css'
import type { CadTapeSize, CadTapeTone } from '@caderno-ui/elements/tape'

type Props = {
  class?: string
  size?: CadTapeSize
  tilt?: number
  tone?: CadTapeTone
}
const {
  class: className,
  size = 'md',
  tilt = -1.4,
  tone = 'lemon',
} = Astro.props
---

<cad-tape
  aria-hidden="true"
  class={className}
  size={size}
  tilt={tilt}
  tone={tone}></cad-tape>

<script>
  import '@caderno-ui/elements/tape'
</script>
