---
import '@caderno-ui/elements/fallback.css'

import type { CadToastVariant } from '@caderno-ui/elements/toast'

type Props = {
  class?: string
  description?: string
  dismissible?: boolean
  dismissLabel?: string
  duration?: number
  heading?: string
  open?: boolean
  variant?: CadToastVariant
}

const {
  class: className,
  description,
  dismissible = true,
  dismissLabel = 'Dismiss notification',
  duration = 0,
  heading,
  open = true,
  variant = 'info',
}: Props = Astro.props
---

<cad-toast
  class={className}
  description={description}
  dismiss-label={dismissLabel}
  dismissible={dismissible || undefined}
  duration={duration}
  heading={heading}
  open={open || undefined}
  variant={variant}
>
  <slot name="title" slot="title" />
  <slot />
  <slot name="action" slot="action" />
</cad-toast>

<script>
  import '@caderno-ui/elements/toast'
</script>
