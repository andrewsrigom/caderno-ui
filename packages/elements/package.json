      "import": "./dist/breadcrumb/cad-breadcrumb.js"
    },
    "./pagination": {
      "types": "./dist/pagination/cad-pagination.d.ts",
      "import": "./dist/pagination/cad-pagination.js"
    },
    "./avatar": {
      "types": "./dist/avatar/cad-avatar.d.ts",
      "import": "./dist/avatar/cad-avatar.js"
