{
  "name": "@caderno-ui/elements",
  "version": "0.1.0",
  "description": "Framework-agnostic Caderno UI custom elements implemented with Lit.",
  "keywords": [
    "caderno-ui",
    "custom-elements",
    "design-system",
    "lit",
    "web-components"
  ],
  "author": "Andrews Ribeiro Gomes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewsrigom/caderno-ui.git",
    "directory": "packages/elements"
  },
  "homepage": "https://github.com/andrewsrigom/caderno-ui/tree/main/packages/elements#readme",
  "bugs": {
    "url": "https://github.com/andrewsrigom/caderno-ui/issues"
  },
  "type": "module",
  "files": [
    "custom-elements.json",
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./alert": {
      "types": "./dist/alert/cad-alert.d.ts",
      "import": "./dist/alert/cad-alert.js"
    },
    "./badge": {
      "types": "./dist/badge/cad-badge.d.ts",
      "import": "./dist/badge/cad-badge.js"
    },
    "./bookmark": {
      "types": "./dist/bookmark/cad-bookmark.d.ts",
      "import": "./dist/bookmark/cad-bookmark.js"
    },
    "./button": {
      "types": "./dist/button/cad-button.d.ts",
      "import": "./dist/button/cad-button.js"
    },
    "./callout": {
      "types": "./dist/callout/cad-callout.d.ts",
      "import": "./dist/callout/cad-callout.js"
    },
    "./card": {
      "types": "./dist/card/cad-card.d.ts",
      "import": "./dist/card/cad-card.js"
    },
    "./chart": {
      "types": "./dist/chart/cad-chart.d.ts",
      "import": "./dist/chart/cad-chart.js"
    },
    "./divider": {
      "types": "./dist/divider/cad-divider.d.ts",
      "import": "./dist/divider/cad-divider.js"
    },
    "./icon": {
      "types": "./dist/icon/cad-icon.d.ts",
      "import": "./dist/icon/cad-icon.js"
    },
    "./link": {
      "types": "./dist/link/cad-link.d.ts",
      "import": "./dist/link/cad-link.js"
    },
    "./note": {
      "types": "./dist/note/cad-note.d.ts",
      "import": "./dist/note/cad-note.js"
    },
    "./progress": {
      "types": "./dist/progress/cad-progress.d.ts",
      "import": "./dist/progress/cad-progress.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "import": "./dist/tabs/index.js"
    },
    "./fallback.css": "./src/styles/fallback.css",
    "./input": {
      "types": "./dist/input/cad-input.d.ts",
      "import": "./dist/input/cad-input.js"
    },
    "./textarea": {
      "types": "./dist/textarea/cad-textarea.d.ts",
      "import": "./dist/textarea/cad-textarea.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/cad-checkbox.d.ts",
      "import": "./dist/checkbox/cad-checkbox.js"
    },
    "./radio": {
      "types": "./dist/radio/cad-radio.d.ts",
      "import": "./dist/radio/cad-radio.js"
    },
    "./accordion": {
      "types": "./dist/accordion/cad-accordion.d.ts",
      "import": "./dist/accordion/cad-accordion.js"
    }
  },
  "sideEffects": [
    "**/*.js",
    "**/*.css"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "pnpm test:browser",
    "test:browser": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@caderno-ui/icons": "workspace:^",
    "lit": "^3.3.3",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "customElements": "./custom-elements.json"
}
