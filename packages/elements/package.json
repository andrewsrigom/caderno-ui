    },
    "./paper": {
      "types": "./dist/paper/cad-paper.d.ts",
      "import": "./dist/paper/cad-paper.js"
    }
  },
  "sideEffects": [
    "**/*.js",
    "**/*.css"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "pnpm test:browser",
    "test:browser": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@caderno-ui/icons": "workspace:^",
    "lit": "^3.3.3",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "customElements": "./custom-elements.json"
