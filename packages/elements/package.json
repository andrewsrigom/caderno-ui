{
  "name": "@caderno-ui/elements",
  "version": "0.3.0",
  "description": "Framework-agnostic Caderno UI custom elements implemented with Lit.",
  "keywords": [
    "caderno-ui",
    "custom-elements",
    "design-system",
    "lit",
    "web-components"
  ],
  "author": "Andrews Ribeiro Gomes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewsrigom/caderno-ui.git",
    "directory": "packages/elements"
  },
  "homepage": "https://github.com/andrewsrigom/caderno-ui/tree/main/packages/elements#readme",
  "bugs": {
    "url": "https://github.com/andrewsrigom/caderno-ui/issues"
  },
  "type": "module",
  "files": [
    "custom-elements.json",
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./alert": {
      "types": "./dist/alert/cad-alert.d.ts",
      "import": "./dist/alert/cad-alert.js"
    },
    "./badge": {
      "types": "./dist/badge/cad-badge.d.ts",
      "import": "./dist/badge/cad-badge.js"
    },
