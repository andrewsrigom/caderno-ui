    },
    "./checklist": {
      "types": "./dist/checklist/cad-checklist.d.ts",
      "import": "./dist/checklist/cad-checklist.js"
    },
    "./code-block": {
      "types": "./dist/code-block/cad-code-block.d.ts",
      "import": "./dist/code-block/cad-code-block.js"
    },
    "./empty-state": {
      "types": "./dist/empty-state/cad-empty-state.d.ts",
