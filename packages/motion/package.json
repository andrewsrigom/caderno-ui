{
  "name": "@caderno-ui/motion",
  "version": "0.3.0",
  "description": "Accessible motion presets and opt-in GSAP choreography for Caderno UI.",
  "keywords": [
    "animation",
    "caderno-ui",
    "design-system",
    "gsap",
    "motion"
  ],
  "author": "Andrews Ribeiro Gomes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewsrigom/caderno-ui.git",
    "directory": "packages/motion"
  },
  "homepage": "https://github.com/andrewsrigom/caderno-ui/tree/main/packages/motion#readme",
  "bugs": {
    "url": "https://github.com/andrewsrigom/caderno-ui/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scroll": {
      "types": "./dist/scroll.d.ts",
      "import": "./dist/scroll.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
